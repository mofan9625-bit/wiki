---
interface Props {
  title?: string;
  treeText: string;
}

const { title = "快速选型与排查决策树", treeText } = Astro.props;
---

<div class="my-6 rounded-xl border border-slate-200 bg-slate-900 text-slate-100 p-5 shadow-sm overflow-hidden">
  <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-800">
    <div class="flex items-center space-x-2">
      <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
      <span class="text-sm font-semibold tracking-wide text-slate-200">{title}</span>
    </div>
    <span class="text-xs text-slate-400 font-mono">3–4 层逻辑分支</span>
  </div>
  <pre class="font-mono text-xs sm:text-sm text-emerald-300/90 leading-relaxed overflow-x-auto p-0 m-0 bg-transparent select-text">
{treeText}
  </pre>
</div>
