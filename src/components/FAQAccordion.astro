---
interface FAQItem {
  q: string;
  a: string;
}

interface Props {
  faqs: FAQItem[];
  title?: string;
}

const { faqs, title = "常见核心问题解答 (FAQ)" } = Astro.props;
---

<div class="my-8">
  <h3 class="text-xl font-bold text-slate-900 mb-4 flex items-center space-x-2">
    <svg width="20" height="20" style="max-width:20px;max-height:20px;display:inline-block;" class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <span>{title}</span>
  </h3>
  <div class="space-y-3">
    {faqs.map((faq, idx) => (
      <details class="group rounded-xl border border-slate-200 bg-white p-4 transition-colors hover:border-slate-300 open:bg-slate-50/50 open:border-blue-200">
        <summary class="flex cursor-pointer items-center justify-between text-base font-semibold text-slate-900 select-none">
          <span class="flex items-center space-x-2.5">
            <span class="text-xs font-mono font-bold text-blue-600 bg-blue-50 px-2 py-0.5 rounded">
              Q{idx + 1}
            </span>
            <span>{faq.q}</span>
          </span>
          <svg width="16" height="16" style="max-width:16px;max-height:16px;display:inline-block;" class="h-4 w-4 text-slate-400 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <div class="mt-3 text-[15px] leading-relaxed text-slate-600 border-t border-slate-100 pt-3 pl-8">
          {faq.a}
        </div>
      </details>
    ))}
  </div>
</div>
