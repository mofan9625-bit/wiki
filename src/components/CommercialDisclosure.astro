---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class={`rounded-lg bg-blue-50/70 border border-blue-200/80 text-blue-900 ${compact ? 'p-2.5 text-xs' : 'p-3.5 text-xs sm:text-sm'} my-4`}>
  <div class="flex items-start space-x-2">
    <svg width="16" height="16" style="max-width:16px;max-height:16px;display:inline-block;" class="w-4 h-4 text-blue-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <div class="leading-relaxed">
      <span class="font-semibold text-blue-950">商业合作透明披露：</span>
      本页面含推广链接，通过链接注册可能为本站带来推荐佣金，这不会影响您的最终支付价格。评测指标均由独立测试记录与公开资料核验支撑。
    </div>
  </div>
</div>
