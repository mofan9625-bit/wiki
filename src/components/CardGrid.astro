---
interface Props {
  columns?: 2 | 3 | 4;
}

const { columns = 3 } = Astro.props;
---

<div class={`grid gap-5 ${
  columns === 2 ? 'grid-cols-1 md:grid-cols-2' :
  columns === 4 ? 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4' :
  'grid-cols-1 md:grid-cols-2 lg:grid-cols-3'
} my-6`}>
  <slot />
</div>
