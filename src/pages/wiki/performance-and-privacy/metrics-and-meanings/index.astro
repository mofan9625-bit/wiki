const pillar = {"id":"wiki","name":"机场百科","slug":"wiki","url":"/wiki/","h1":"机场百科：线路、协议、网络指标与隐私边界知识体系","coreQuestion":"哪些概念和技术机制，会真正影响机场选择与使用？","theme":"理解技术","targetWords":"7,000–9,500 字","duty":"引用标准和技术规范，拒绝粗暴宣传语。严谨解释IPLC/IEPL、TCP/UDP/QUIC、TLS、分片MTU及数据边界。","megaTableCols":["技术术语/协议","层级分类","工作机制","相比传统优势","核心局限/风险","对日常体验影响","规范文档引用","相关条目"],"decisionLevels":4,"topics":[{"id":"service-and-lines","name":"服务结构与线路实体","slug":"service-and-lines","url":"/wiki/service-and-lines/","h1":"服务结构与线路实体：入口出口拓扑、IPLC/IEPL专线与中转直连","desc":"建立机场通信拓扑模型，界定客户端、订阅中心、中继入口、出口机房等实体关系。","clusters":[{"id":"nodes-and-clients-relation","name":"订阅节点与客户端","slug":"nodes-and-clients-relation","url":"/wiki/service-and-lines/nodes-and-clients-relation/","h1":"订阅节点与客户端：服务拓扑、订阅下发通信流程与角色定义","coreQuestion":"从点击网页链接到数据包跨洋到达目标服务器，中间经历了哪些实体？","articles":[{"id":"art-wik-001","title":"机场服务是什么：组成与角色"},{"id":"art-wik-002","title":"客户端、订阅与节点的关系"},{"id":"art-wik-003","title":"服务组成概念图"},{"id":"art-wik-004","title":"服务实体的角色说明"},{"id":"art-wik-005","title":"订阅与节点的通信流程"},{"id":"art-wik-006","title":"订阅节点与客户端完整说明"}]},{"id":"entry-exit-and-line-tags","name":"入口出口与线路标签","slug":"entry-exit-and-line-tags","url":"/wiki/service-and-lines/entry-exit-and-line-tags/","h1":"入口出口与线路标签：IEPL内网专线、IPLC物理专线与普通BGP中转","coreQuestion":"商家宣传的IPLC与IEPL专线到底有什么区别？专线为什么不怕晚高峰？","articles":[{"id":"art-wik-007","title":"IEPL 专线说明"},{"id":"art-wik-008","title":"IPLC 专线说明"},{"id":"art-wik-009","title":"中转与直连的区别"},{"id":"art-wik-010","title":"线路类型的实际影响"},{"id":"art-wik-011","title":"线路标签与实际观测的区别"},{"id":"art-wik-012","title":"入口出口与线路标签完整说明"}]}]},{"id":"protocols-and-security","name":"传输协议与安全机制","slug":"protocols-and-security","url":"/wiki/protocols-and-security/","h1":"传输协议与安全机制：TCP/UDP/QUIC、TLS握手与VLESS/Trojan协议分层","desc":"依据IETF RFC深入解析网络丢包重传、QUIC多路复用以及现代轻量协议加密机制。","clusters":[{"id":"tcp-udp-and-quic","name":"TCP UDP与QUIC","slug":"tcp-udp-and-quic","url":"/wiki/protocols-and-security/tcp-udp-and-quic/","h1":"TCP UDP与QUIC：可靠传输、重传拥塞控制、多路复用与MTU分片","c