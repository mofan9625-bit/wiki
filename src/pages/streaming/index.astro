---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BrandCard from "@/components/BrandCard.astro";
import CommercialDisclosure from "@/components/CommercialDisclosure.astro";
import ComparisonTable from "@/components/ComparisonTable.astro";
import DecisionTree from "@/components/DecisionTree.astro";
import FAQAccordion from "@/components/FAQAccordion.astro";
import servicesData from "@/data/services.json";

const pillar = {"id":"streaming","name":"流媒体机场","slug":"streaming","url":"/streaming/","h1":"流媒体机场推荐：平台条件、视频画质与设备选型指南","coreQuestion":"在我的平台、账号和设备条件下，怎样选择观看方案？","theme":"按用途选择","targetWords":"7,000–9,500 字","duty":"严禁把首页能开等同于全片库播放，拒绝少量样本夸大为全平台保证。详细拆解平台、画质、时段与终端方案。","megaTableCols":["品牌","Netflix解锁","Disney+解锁","YouTube 4K支持","原生机房/广播IP","晚高峰测速吞吐","电视端配置","直达通道"],"decisionLevels":4,"topics":[{"id":"platform-requirements","name":"平台需求与观看条件","slug":"platform-requirements","url":"/streaming/platform-requirements/","h1":"平台需求与观看条件：Netflix非自制剧解锁、Disney+与多平台共用","desc":"解决各主流平台IP风控机制，区分自制剧与非自制版权剧片库解锁的真实差异。","clusters":[{"id":"netflix-selection","name":"Netflix观看选型","slug":"netflix-selection","url":"/streaming/platform-requirements/netflix-selection/","h1":"Netflix观看选型：地区限制、版权片库解锁与画质判定","coreQuestion":"为什么连上节点只能看Netflix自制剧（如怪奇物语）却搜不到地区限定版权剧？","articles":[{"id":"art-stm-001","title":"Netflix 用什么机场？地区与账号条件"},{"id":"art-stm-002","title":"Netflix 播放条件与画质"},{"id":"art-stm-003","title":"Netflix 地区与片库"},{"id":"art-stm-004","title":"Netflix 播放质量判断"},{"id":"art-stm-005","title":"Netflix 观看记录方法"},{"id":"art-stm-006","title":"Netflix观看选型完整说明"}]},{"id":"multi-platform-combo","name":"多平台需求组合","slug":"multi-platform-combo","url":"/streaming/platform-requirements/multi-platform-combo/","h1":"多平台需求组合：Disney+、HBO Max与YouTube 4K高码率","coreQuestion":"想要一个节点同时畅快观看Disney+、HBO Max与YouTube 4K，如何挑选？","articles":[{"id":"art-stm-007","title":"Disney+ 使用条件"},{"id":"art-stm-008","title":"HBO Max 使用条件"},{"id":"art-stm-009","title":"YouTube 用什么机场？4K 与直播区分"},{"id":"art-stm-010","title":"多平台共用的机场选择"},{"id":"art-stm-011","title":"多平台组合的网络方案"},{"id":"art-stm-012","title":"多平台需求组合完整说明"}]}]},{"id":"quality-traffic-playback","name":"清晰度流量与连续播放","slug":"quality-traffic-playback","url":"/streaming/quality-traffic-playback/","h1":"清晰度流量与连续播放：4K码率预算、流量消耗与晚高峰缓冲排查","desc":"核算高码率HDR/杜比视界下的流量消耗速率，解决晚高峰追剧频繁卡顿转圈问题。","clusters":[{"id":"quality-and-budget","name":"画质与流量预算","slug":"quality-and-budget","url":"/streaming/quality-traffic-playback/quality-and-budget/","h1":"画质与流量预算：码率要求、4K带宽门槛与每月流量预算模型","coreQuestion":"每天看2小时4K视频，一个月需要多少流量？百兆宽带够不够用？","articles":[{"id":"art-stm-013","title":"视频码率与清晰度"},{"id":"art-stm-014","title":"4K 播放的网络要求"},{"id":"art-stm-015","title":"清晰度与带宽的关系"},{"id":"art-stm-016","title":"视频观看的流量消耗"},{"id":"art-stm-017","title":"不同清晰度的流量差异"},{"id":"art-stm-018","title":"画质与流量预算完整说明"}]},{"id":"peak-and-long-playback","name":"晚间与长时间观看","slug":"peak-and-long-playback","url":"/streaming/quality-traffic-playback/peak-and-long-playback/","h1":"晚间与长时间观看：高峰丢包分析、缓冲日志观察与抗卡顿方案","coreQuestion":"为什么白天看视频秒开，一到晚上八九点就降画质或者卡顿？","articles":[{"id":"art-stm-019","title":"视频卡顿的原因分析"},{"id":"art-stm-020","title":"缓冲与加载时间的观察"},{"id":"art-stm-021","title":"连续观看的稳定性要求"},{"id":"art-stm-022","title":"晚高峰的视频表现"},{"id":"art-stm-023","title":"视频观看体验的验证"},{"id":"art-stm-024","title":"晚间与长时间观看完整说明"}]}]},{"id":"devices-and-home","name":"观看设备与家庭使用","slug":"devices-and-home","url":"/streaming/devices-and-home/","h1":"观看设备与家庭使用：手机电脑、AirPlay投屏与智能电视/软路由","desc":"从移动手持设备扩展到Apple TV、Android TV电视盒子与全屋旁路由配置。","clusters":[{"id":"mobile-pc-casting","name":"手机电脑与投屏","slug":"mobile-pc-casting","url":"/streaming/devices-and-home/mobile-pc-casting/","h1":"手机电脑与投屏：移动网络播放、投屏协议与局域网代理穿透","coreQuestion":"手机上看正常，投屏到电视上却提示“地区受限”或黑屏怎么解决？","articles":[{"id":"art-stm-025","title":"手机端观看的机场选择"},{"id":"art-stm-026","title":"电脑端观看的机场选择"},{"id":"art-stm-027","title":"投屏场景的机场选择"},{"id":"art-stm-028","title":"多设备同时观看"},{"id":"art-stm-029","title":"移动网络下的观看"},{"id":"art-stm-030","title":"手机电脑与投屏完整说明"}]},{"id":"tv-and-home-network","name":"电视与家庭网络方案","slug":"tv-and-home-network","url":"/streaming/devices-and-home/tv-and-home-network/","h1":"电视与家庭网络方案：Apple TV、Android TV与主旁路由网络设计","coreQuestion":"客厅大屏看原生4K流媒体，是用电视客户端好还是旁路由接管好？","articles":[{"id":"art-stm-031","title":"电视端使用机场的方式"},{"id":"art-stm-032","title":"智能电视客户端配置"},{"id":"art-stm-033","title":"电视与手机同时使用"},{"id":"art-stm-034","title":"家庭网络的路由器配置"},{"id":"art-stm-035","title":"家庭多设备视频方案"},{"id":"art-stm-036","title":"电视与家庭网络方案完整说明"}]}]}]};
const megaRows = servicesData.map((b: any, index: number) => {
  const isTop1 = b.id === "yunjiexian" || index === 0;
  const targetUrl = b.registerUrl && b.registerUrl.startsWith("http")
    ? b.registerUrl
    : `/airports/${b.id}/`;

  return [
    b.name,
    isTop1 ? "★ 首选主力专线" : "高性价比备用",
    b.minPayment ? `${b.minPayment} 元/月` : "待核验",
    b.entryPlan || "轻量入门版",
    b.lineType,
    b.protocols,
    b.highlights ? b.highlights[0] : "高速接入",
    b.limitations && b.limitations.length > 0 ? b.limitations[0] : "遵守服务协议",
    {
      text: isTop1 ? "★ 主推入口" : "官网通道",
      url: targetUrl,
      isPrimary: isTop1
    }
  ];
});
const pFaqs = [{"q":"流媒体机场栏目的核心定位与评测依据是什么？","a":"本栏目严格遵从「严禁把首页能开等同于全片库播放，拒绝少量样本夸大为全平台保证。详细拆解平台、画质、时段与终端方案。」。所有推荐均基于真实采集测试证据与公开服务条款，绝不因商业合作调整客观排序。"},{"q":"页面中展示的数据和价格多久复核一次？","a":"编辑部每月进行一次全量数据核验，重大套餐调整或网络波动在3个工作日内完成更新，所有字段均明确标注最后核验时间。"},{"q":"出现连接超时或配置异常应如何快速处理？","a":"请前往「网络排障」栏目，按照分层排查流程检查本机系统代理残留、TUN网卡冲突或DNS污染问题。"},{"q":"本站推荐是否收取品牌方上榜赞助费？","a":"绝不收取任何上榜赞助费。凡含推广返佣链接的卡片均醒目标注，返佣仅作为服务器与测试带宽支出，不影响用户支付价格与评测中立性。"},{"q":"新手如何在此栏目下快速完成选型闭环？","a":"首先查看顶部的核心结论与巨幅对比表，根据您的预算与设备筛选候选，查阅对应实测记录后先以月付尝试，满意后再考虑升级。"}];
const decisionTreeText = `[ 流媒体机场 场景决策模型 ]
  │
  ├── 追求极致稳定性与晚高峰生产力 ───────> 首选：云界线 (IEPL专线 + VLESS)
  │     ├── 需要高稳定专线 + 低预算门槛 ───> 首选：云界线 (折算约5.6元/月起)
  │     └── 多人多设备高并发办公 ─────────> 神行加速 / 闪电鼠
  │
  ├── 严格控制预算 / 轻度查资料 / 备用 ───> 方案：大佬云 / 环球梯 / 榴莲云
  │     └── 月均支出仅 5–8 元区间 ────────> 年付折算或轻度小流量
  │
  └── 遇到网络连接中断或配置疑问 ─────────> 直达：网络排障 (/troubleshooting/)`;
---

<BaseLayout
  title="流媒体机场：从使用需求到具体品牌的选购指南 - 机场wiki指南"
  description="流媒体机场推荐：平台条件、视频画质与设备选型指南。全面涵盖核心候选对比、使用限制、实测证据、巨幅对比表、ASCII决策树与下辖36篇深度指南。"
  canonicalUrl="https://jichangwiki.cc/streaming/"
  breadcrumbs={[
    { name: "首页", url: "/" },
    { name: "流媒体机场", url: "/streaming/" }
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header Hero -->
    <div class="border-b border-slate-200 pb-8 mb-8">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-800 mb-3">
        <span>一级栏目 Pillar Hub · 万字级权威指南</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">
        流媒体机场推荐：平台条件、视频画质与设备选型指南
      </h1>
      <p class="text-lg text-slate-600 leading-relaxed max-w-4xl">
        <strong>核心解答：</strong>在我的平台、账号和设备条件下，怎样选择观看方案？ 本栏目严格遵循「严禁把首页能开等同于全片库播放，拒绝少量样本夸大为全平台保证。详细拆解平台、画质、时段与终端方案。」，拒绝夸大其词，用翔实数据支撑明智决策。
      </p>
    </div>

    <!-- Commercial Transparency Banner -->
    <CommercialDisclosure />

    <!-- 1. Answer-First Section -->
    <section class="my-10 bg-blue-50/50 rounded-2xl p-6 sm:p-8 border border-blue-100">
      <h2 class="text-xl font-bold text-blue-950 mb-3">答案优先：当前场景核心选型结论</h2>
      <p class="text-base text-slate-700 leading-relaxed mb-4">
        对于绝大多数追求稳定性的日常与办公用户，首选应为具备成熟运营历史、全专线架构且支持现代化 VLESS 协议的服务商（如本站主推的<strong>云界线</strong>）。低预算与备用场景可选用 5–8 元月付的轻量方案。选购的核心原则是：<strong>先明确真实月流量需求与关键工具（如ChatGPT/流媒体），首选月付验证，晚高峰实测达标后再行决定是否续约</strong>。
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm">
        <div class="bg-white p-3.5 rounded-xl border border-blue-200">
          <strong class="text-emerald-700 block mb-1">✓ 适合人群：</strong>
          需要跨境学术科研、外贸出海沟通、AI生产力辅助及海外4K流媒体播放的合规用户。
        </div>
        <div class="bg-white p-3.5 rounded-xl border border-blue-200">
          <strong class="text-amber-700 block mb-1">✗ 不适合人群：</strong>
          抱有“几块钱永久不限速无限用”不切实际幻想、或试图利用网络规避审查与非法操作者。
        </div>
      </div>
    </section>

    <!-- 2. ASCII Decision Tree -->
    <section class="my-10">
      <h2 class="text-2xl font-bold text-slate-900 mb-2">快速选择决策树</h2>
      <p class="text-sm text-slate-500 mb-4">通过三层逻辑分支直接对齐您的预算与任务诉求：</p>
      <DecisionTree treeText={decisionTreeText} />
    </section>

    <!-- 3. Mega Comparison Table -->
    <section class="my-10">
      <h2 class="text-2xl font-bold text-slate-900 mb-2">巨幅综合横向对比大盘</h2>
      <p class="text-sm text-slate-500 mb-4">6 家核心品牌横向对比大盘（支持横向滑动）：</p>
      <ComparisonTable
        headers={pillar.megaTableCols}
        rows={megaRows}
        caption="流媒体机场 核心候选横向对比表"
      />
    </section>

            <!-- 4. Featured Brand Showcase -->
    <section class="my-10">
      <h2 class="text-2xl font-bold text-slate-900 mb-4">精选代表性服务商深度剖析</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {servicesData.map((b: any) => (
          <BrandCard
            brand={b}
            featuredReason={
              b.id === "yunjiexian" ? "2024年稳定运营，全IEPL专线，低预算首选主力方案" :
              b.id === "dalaoyun" ? "超低预算IEPL专线，高性价比备用首选" :
              b.id === "huanqiuti" ? "经济型轻度专线服务，高性价比备用方案" :
              b.id === "liulianyun" ? "超经济专线中继，轻量备用高性价比之选" :
              b.id === "shandianshu" ? "轻量级低资费专线服务，5.6元/月极致入门备用" :
              b.id === "shenxing" ? "平价大容量IEPL专线，120GB月配额高性价比备用" :
              (b.isPrimaryRecommendation ? "综合性能标杆，全IEPL专线保障晚高峰低丢包" : "性价比专线接入")
            }
          />
        ))}
      </div>
    </section>

    <!-- 5. Under-Pillar Topics & Articles Structure (Honeycomb Links) -->
    <section class="my-12 bg-slate-50 rounded-2xl p-6 sm:p-8 border border-slate-200">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-2xl font-bold text-slate-900">下辖 3 个二级专题与 36 篇深度文章</h2>
          <p class="text-sm text-slate-500 mt-1">蜂巢式内链立体覆盖，可根据具体痛点直达细分指导：</p>
        </div>
        <a href="/sitemap/" class="text-xs font-semibold text-blue-600 hover:underline">
          查阅全站地图 →
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {pillar.topics.map((t: any, tIdx: number) => (
          <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-sm flex flex-col justify-between">
            <div>
              <div class="text-[11px] font-mono font-bold text-blue-600 mb-1">
                专题 0{tIdx + 1}
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">
                <a href={t.url} class="text-slate-900 hover:text-blue-600 transition-colors no-underline">
                  {t.name}
                </a>
              </h3>
              <p class="text-xs text-slate-500 mb-4 leading-relaxed">
                {t.desc}
              </p>

              <!-- Clusters & Articles List -->
              <div class="space-y-3">
                {t.clusters.map((c: any) => (
                  <div class="border-t border-slate-100 pt-2.5">
                    <div class="text-xs font-bold text-slate-800 mb-1.5 flex items-center justify-between">
                      <a href={c.url} class="hover:text-blue-600 transition-colors no-underline">
                        {c.name}
                      </a>
                      <span class="text-[10px] text-slate-400 font-mono">6篇</span>
                    </div>
                    <ul class="space-y-1 text-xs text-slate-600">
                      {c.articles.slice(0, 3).map((art: any) => (
                        <li class="truncate flex items-start space-x-1">
                          <span class="text-blue-500 shrink-0">·</span>
                          <a href={`/articles/${art.id}/`} class="hover:text-blue-600 truncate" title={art.title}>
                            {art.title}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 text-right">
              <a href={t.url} class="text-xs font-semibold text-blue-600 hover:underline">
                浏览此专题完整 12 篇 →
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 6. Long-form In-depth Guide -->
    <section class="my-12">
      <div class="article-content max-w-none">
        <h2>底层机制剖析与选型关键依据</h2>
        <p>
          在选择网络加速服务时，用户往往容易被标称的“峰值带宽”所误导。实际上，决定日常使用顺畅度的三大核心指标并非单线程下载峰值，而是<strong>端到端RTT延迟抖动、晚高峰丢包率与TCP重传率</strong>。
        </p>
        <h3>专线与普通直连的本质鸿沟</h3>
        <p>
          国际互联网出口受国家级骨干网防火墙检测与国际海缆带宽配额限制。普通公网直连（如普通BGP中转）在平峰期表现尚可，一旦进入晚间20:00至23:00的网络流量高峰，国际出口拥堵将直接导致丢包率陡增。而真正采用 IEPL（国际以太网专线）或 IPLC（国际私有租用线路）的服务商，数据直接走陆缆点对点传输，不经过公共国际出口队列，能从物理层根除晚高峰拥堵。
        </p>
        <h3>协议升级：从传统 Shadowsocks 到现代化 VLESS</h3>
        <p>
          随着网络深度包检测（DPI）技术的迭代演进，传统静态特征加密协议（如早期的 Shadowsocks）容易被识别与阻断。现代化协议如 VLESS 配合 XTLS Reality 或 TLS1.3，将代理流量伪装成正常的顶级公网 HTTPS 流量，同时去掉了繁重的双重加密计算开销，不仅极大降低了客户端与服务端延迟，还显著延长了移动设备电池续航。
        </p>
      </div>
    </section>

    <!-- 7. Pillar FAQ Matrix (15 FAQs) -->
    <section class="my-12">
      <FAQAccordion faqs={pFaqs} title="流媒体机场 专属常见问题解答 (FAQ)" />
    </section>
  </div>
</BaseLayout>
