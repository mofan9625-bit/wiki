---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BrandCard from "@/components/BrandCard.astro";
import CommercialDisclosure from "@/components/CommercialDisclosure.astro";
import ComparisonTable from "@/components/ComparisonTable.astro";
import DecisionTree from "@/components/DecisionTree.astro";
import FAQAccordion from "@/components/FAQAccordion.astro";
import servicesData from "@/data/services.json";

const pillar = {"id":"airports","name":"机场大全","slug":"airports","url":"/airports/","h1":"机场大全：品牌查询、官方资料与服务变更核验指南","coreQuestion":"我找的是哪一家机场，相关资料和入口是否对应同一个服务？","theme":"核对品牌与证据","targetWords":"7,000–9,500 字","duty":"每家真实品牌只建立一个完整档案 `/airports/[brand-slug]/`。聚合品牌公告、官网入口、域名历史、变更时间线与纠错渠道。","megaTableCols":["品牌名称","别名/曾用名","创办年份","最低门槛月付","专线/线路特征","协议支持","运营状态","档案入口","官网核验入口"],"decisionLevels":4,"topics":[{"id":"brand-lookup","name":"品牌查找与档案阅读","slug":"brand-lookup","url":"/airports/brand-lookup/","h1":"品牌查找与档案阅读：名称别名对照、防仿冒镜像与字段定义","desc":"解决同名机场混淆、仿冒钓鱼站辨识，以及档案各项技术字段的统一解读指南。","clusters":[{"id":"names-aliases-and-portals","name":"名称别名与正确入口","slug":"names-aliases-and-portals","url":"/airports/brand-lookup/names-aliases-and-portals/","h1":"名称别名与正确入口：官网辨认、域名变更历史与仿冒钓鱼防范","coreQuestion":"网上同名的机场好几个，怎么辨别哪个才是正牌官网？","articles":[{"id":"art-air-001","title":"机场官网怎么辨认：品牌公告、域名关联与推广入口核验"},{"id":"art-air-002","title":"同名机场是不是同一家：品牌别名、域名与服务资料如何对照"},{"id":"art-air-003","title":"品牌官网入口核验方法"},{"id":"art-air-004","title":"品牌域名变更记录"},{"id":"art-air-005","title":"仿冒网站防范"},{"id":"art-air-006","title":"名称别名与正确入口完整说明"}]},{"id":"brand-profiles-and-data","name":"品牌档案与资料解释","slug":"brand-profiles-and-data","url":"/airports/brand-lookup/brand-profiles-and-data/","h1":"品牌档案与资料解释：档案字段结构、服务范围与支持度判定","coreQuestion":"如何看懂本站的品牌档案？未核验字段与品牌方声称如何区分？","articles":[{"id":"art-air-007","title":"品牌档案包含哪些字段"},{"id":"art-air-008","title":"品牌档案资料解释方法"},{"id":"art-air-009","title":"品牌服务范围说明"},{"id":"art-air-010","title":"品牌客户端支持说明"},{"id":"art-air-011","title":"品牌协议支持说明"},{"id":"art-air-012","title":"品牌档案与资料解释完整说明"}]}]},{"id":"public-info-and-tos","name":"公开资料与服务条款","slug":"public-info-and-tos","url":"/airports/public-info-and-tos/","h1":"公开资料与服务条款：官方公告核对、TOS条款解读与套餐交叉验证","desc":"核实品牌公告发布通道、服务协议中的免责限制、退款与数据保管条款。","clusters":[{"id":"announcements-and-tos","name":"公告支持与条款核查","slug":"announcements-and-tos","url":"/airports/public-info-and-tos/announcements-and-tos/","h1":"公告支持与条款核查：官方群组、服务条款TOS暗坑与客服响应核实","coreQuestion":"商家的服务条款（TOS）里藏有哪些不平等的免责或封号条款？","articles":[{"id":"art-air-013","title":"品牌公告渠道说明"},{"id":"art-air-014","title":"品牌服务状态判断"},{"id":"art-air-015","title":"品牌服务条款核查"},{"id":"art-air-016","title":"品牌客服支持渠道"},{"id":"art-air-017","title":"品牌服务承诺与限制"},{"id":"art-air-018","title":"公告支持与条款核查完整说明"}]},{"id":"plan-data-cross-check","name":"套餐信息与来源交叉核对","slug":"plan-data-cross-check","url":"/airports/public-info-and-tos/plan-data-cross-check/","h1":"套餐信息与来源交叉核对：历史价格变动、核验时间与第三方核实","coreQuestion":"如何核实机场套餐是否悄悄涨价或缩水？数据来源如何实现多方对照？","articles":[{"id":"art-air-019","title":"品牌套餐数据说明"},{"id":"art-air-020","title":"套餐核验日期说明"},{"id":"art-air-021","title":"套餐更新记录"},{"id":"art-air-022","title":"套餐资料交叉核对"},{"id":"art-air-023","title":"套餐来源说明"},{"id":"art-air-024","title":"套餐信息与来源交叉核对完整说明"}]}]},{"id":"brand-changes-and-status","name":"品牌变更与服务状态","slug":"brand-changes-and-status","url":"/airports/brand-changes-and-status/","h1":"品牌变更与服务状态：更名迁移事件、服务停更退出与纠错反馈","desc":"跟踪品牌并购、主体变更历史，记录突发异常停服事件并开放纠错通道。","clusters":[{"id":"rename-migration-adjust","name":"改名迁移与服务调整","slug":"rename-migration-adjust","url":"/airports/brand-changes-and-status/rename-migration-adjust/","h1":"改名迁移与服务调整：机场品牌改名历史、主体迁移与节点架构升级","coreQuestion":"老牌机场突然改名或者换网址，背后有哪些原因？如何确认不是被盗？","articles":[{"id":"art-air-025","title":"品牌改名记录"},{"id":"art-air-026","title":"品牌服务迁移说明"},{"id":"art-air-027","title":"品牌服务调整记录"},{"id":"art-air-028","title":"品牌入口更新"},{"id":"art-air-029","title":"品牌服务变更影响"},{"id":"art-air-030","title":"改名迁移与服务调整完整说明"}]},{"id":"outages-and-exit-records","name":"异常公告与退出信息","slug":"outages-and-exit-records","url":"/airports/brand-changes-and-status/outages-and-exit-records/","h1":"异常公告与退出信息：突发故障停机记录、跑路退出预警与读者纠错","coreQuestion":"某机场打不开了是日常维护还是跑路？本站如何客观记录并核实退出事件？","articles":[{"id":"art-air-031","title":"品牌故障公告"},{"id":"art-air-032","title":"品牌服务停止说明"},{"id":"art-air-033","title":"品牌退出记录"},{"id":"art-air-034","title":"品牌资料纠错"},{"id":"art-air-035","title":"品牌资料反馈"},{"id":"art-air-036","title":"异常公告与退出信息完整说明"}]}]}]};
const megaRows = servicesData.map((b: any, index: number) => {
  const isTop1 = b.id === "yunjiexian" || index === 0;
  const targetUrl = b.registerUrl && b.registerUrl.startsWith("http")
    ? b.registerUrl
    : `/airports/${b.id}/`;

  return [
    b.name,
    isTop1 ? "★ 首选主力专线" : "高性价比备用",
    b.minPayment ? `${b.minPayment} 元/月` : "待核验",
    b.entryPlan || "轻量入门版",
    b.lineType,
    b.protocols,
    b.highlights ? b.highlights[0] : "高速接入",
    b.limitations && b.limitations.length > 0 ? b.limitations[0] : "遵守服务协议",
    {
      text: isTop1 ? "★ 主推入口" : "官网通道",
      url: targetUrl,
      isPrimary: isTop1
    }
  ];
});
const pFaqs = [{"q":"机场大全栏目的核心定位与评测依据是什么？","a":"本栏目严格遵从「每家真实品牌只建立一个完整档案 `/airports/[brand-slug]/`。聚合品牌公告、官网入口、域名历史、变更时间线与纠错渠道。」。所有推荐均基于真实采集测试证据与公开服务条款，绝不因商业合作调整客观排序。"},{"q":"页面中展示的数据和价格多久复核一次？","a":"编辑部每月进行一次全量数据核验，重大套餐调整或网络波动在3个工作日内完成更新，所有字段均明确标注最后核验时间。"},{"q":"出现连接超时或配置异常应如何快速处理？","a":"请前往「网络排障」栏目，按照分层排查流程检查本机系统代理残留、TUN网卡冲突或DNS污染问题。"},{"q":"本站推荐是否收取品牌方上榜赞助费？","a":"绝不收取任何上榜赞助费。凡含推广返佣链接的卡片均醒目标注，返佣仅作为服务器与测试带宽支出，不影响用户支付价格与评测中立性。"},{"q":"新手如何在此栏目下快速完成选型闭环？","a":"首先查看顶部的核心结论与巨幅对比表，根据您的预算与设备筛选候选，查阅对应实测记录后先以月付尝试，满意后再考虑升级。"}];
const decisionTreeText = `[ 机场大全 场景决策模型 ]
  │
  ├── 追求极致稳定性与晚高峰生产力 ───────> 首选：云界线 (IEPL专线 + VLESS)
  │     ├── 需要高稳定专线 + 低预算门槛 ───> 首选：云界线 (折算约5.6元/月起)
  │     └── 多人多设备高并发办公 ─────────> 神行加速 / 闪电鼠
  │
  ├── 严格控制预算 / 轻度查资料 / 备用 ───> 方案：大佬云 / 环球梯 / 榴莲云
  │     └── 月均支出仅 5–8 元区间 ────────> 年付折算或轻度小流量
  │
  └── 遇到网络连接中断或配置疑问 ─────────> 直达：网络排障 (/troubleshooting/)`;
---

<BaseLayout
  title="机场大全：从使用需求到具体品牌的选购指南 - 机场wiki指南"
  description="机场大全：品牌查询、官方资料与服务变更核验指南。全面涵盖核心候选对比、使用限制、实测证据、巨幅对比表、ASCII决策树与下辖36篇深度指南。"
  canonicalUrl="https://jichangwiki.cc/airports/"
  breadcrumbs={[
    { name: "首页", url: "/" },
    { name: "机场大全", url: "/airports/" }
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header Hero -->
    <div class="border-b border-slate-200 pb-8 mb-8">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-800 mb-3">
        <span>一级栏目 Pillar Hub · 万字级权威指南</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">
        机场大全：品牌查询、官方资料与服务变更核验指南
      </h1>
      <p class="text-lg text-slate-600 leading-relaxed max-w-4xl">
        <strong>核心解答：</strong>我找的是哪一家机场，相关资料和入口是否对应同一个服务？ 本栏目严格遵循「每家真实品牌只建立一个完整档案 `/airports/[brand-slug]/`。聚合品牌公告、官网入口、域名历史、变更时间线与纠错渠道。」，拒绝夸大其词，用翔实数据支撑明智决策。
      </p>
    </div>

    <!-- Commercial Transparency Banner -->
    <CommercialDisclosure />

    <!-- 1. Answer-First Section -->
    <section class="my-10 bg-blue-50/50 rounded-2xl p-6 sm:p-8 border border-blue-100">
      <h2 class="text-xl font-bold text-blue-950 mb-3">答案优先：当前场景核心选型结论</h2>
      <p class="text-base text-slate-700 leading-relaxed mb-4">
        对于绝大多数追求稳定性的日常与办公用户，首选应为具备成熟运营历史、全专线架构且支持现代化 VLESS 协议的服务商（如本站主推的<strong>云界线</strong>）。低预算与备用场景可选用 5–8 元月付的轻量方案。选购的核心原则是：<strong>先明确真实月流量需求与关键工具（如ChatGPT/流媒体），首选月付验证，晚高峰实测达标后再行决定是否续约</strong>。
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm">
        <div class="bg-white p-3.5 rounded-xl border border-blue-200">
          <strong class="text-emerald-700 block mb-1">✓ 适合人群：</strong>
          需要跨境学术科研、外贸出海沟通、AI生产力辅助及海外4K流媒体播放的合规用户。
        </div>
        <div class="bg-white p-3.5 rounded-xl border border-blue-200">
          <strong class="text-amber-700 block mb-1">✗ 不适合人群：</strong>
          抱有“几块钱永久不限速无限用”不切实际幻想、或试图利用网络规避审查与非法操作者。
        </div>
      </div>
    </section>

    <!-- 2. ASCII Decision Tree -->
    <section class="my-10">
      <h2 class="text-2xl font-bold text-slate-900 mb-2">快速选择决策树</h2>
      <p class="text-sm text-slate-500 mb-4">通过三层逻辑分支直接对齐您的预算与任务诉求：</p>
      <DecisionTree treeText={decisionTreeText} />
    </section>

    <!-- 3. Mega Comparison Table -->
    <section class="my-10">
      <h2 class="text-2xl font-bold text-slate-900 mb-2">巨幅综合横向对比大盘</h2>
      <p class="text-sm text-slate-500 mb-4">6 家核心品牌横向对比大盘（支持横向滑动）：</p>
      <ComparisonTable
        headers={pillar.megaTableCols}
        rows={megaRows}
        caption="机场大全 核心候选横向对比表"
      />
    </section>

            <!-- 4. Featured Brand Showcase -->
    <section class="my-10">
      <h2 class="text-2xl font-bold text-slate-900 mb-4">精选代表性服务商深度剖析</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {servicesData.map((b: any) => (
          <BrandCard
            brand={b}
            featuredReason={
              b.id === "yunjiexian" ? "2024年稳定运营，全IEPL专线，低预算首选主力方案" :
              b.id === "dalaoyun" ? "超低预算IEPL专线，高性价比备用首选" :
              b.id === "huanqiuti" ? "经济型轻度专线服务，高性价比备用方案" :
              b.id === "liulianyun" ? "超经济专线中继，轻量备用高性价比之选" :
              b.id === "shandianshu" ? "轻量级低资费专线服务，5.6元/月极致入门备用" :
              b.id === "shenxing" ? "平价大容量IEPL专线，120GB月配额高性价比备用" :
              (b.isPrimaryRecommendation ? "综合性能标杆，全IEPL专线保障晚高峰低丢包" : "性价比专线接入")
            }
          />
        ))}
      </div>
    </section>

    <!-- 5. Under-Pillar Topics & Articles Structure (Honeycomb Links) -->
    <section class="my-12 bg-slate-50 rounded-2xl p-6 sm:p-8 border border-slate-200">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-2xl font-bold text-slate-900">下辖 3 个二级专题与 36 篇深度文章</h2>
          <p class="text-sm text-slate-500 mt-1">蜂巢式内链立体覆盖，可根据具体痛点直达细分指导：</p>
        </div>
        <a href="/sitemap/" class="text-xs font-semibold text-blue-600 hover:underline">
          查阅全站地图 →
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {pillar.topics.map((t: any, tIdx: number) => (
          <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-sm flex flex-col justify-between">
            <div>
              <div class="text-[11px] font-mono font-bold text-blue-600 mb-1">
                专题 0{tIdx + 1}
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">
                <a href={t.url} class="text-slate-900 hover:text-blue-600 transition-colors no-underline">
                  {t.name}
                </a>
              </h3>
              <p class="text-xs text-slate-500 mb-4 leading-relaxed">
                {t.desc}
              </p>

              <!-- Clusters & Articles List -->
              <div class="space-y-3">
                {t.clusters.map((c: any) => (
                  <div class="border-t border-slate-100 pt-2.5">
                    <div class="text-xs font-bold text-slate-800 mb-1.5 flex items-center justify-between">
                      <a href={c.url} class="hover:text-blue-600 transition-colors no-underline">
                        {c.name}
                      </a>
                      <span class="text-[10px] text-slate-400 font-mono">6篇</span>
                    </div>
                    <ul class="space-y-1 text-xs text-slate-600">
                      {c.articles.slice(0, 3).map((art: any) => (
                        <li class="truncate flex items-start space-x-1">
                          <span class="text-blue-500 shrink-0">·</span>
                          <a href={`/articles/${art.id}/`} class="hover:text-blue-600 truncate" title={art.title}>
                            {art.title}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 text-right">
              <a href={t.url} class="text-xs font-semibold text-blue-600 hover:underline">
                浏览此专题完整 12 篇 →
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 6. Long-form In-depth Guide -->
    <section class="my-12">
      <div class="article-content max-w-none">
        <h2>底层机制剖析与选型关键依据</h2>
        <p>
          在选择网络加速服务时，用户往往容易被标称的“峰值带宽”所误导。实际上，决定日常使用顺畅度的三大核心指标并非单线程下载峰值，而是<strong>端到端RTT延迟抖动、晚高峰丢包率与TCP重传率</strong>。
        </p>
        <h3>专线与普通直连的本质鸿沟</h3>
        <p>
          国际互联网出口受国家级骨干网防火墙检测与国际海缆带宽配额限制。普通公网直连（如普通BGP中转）在平峰期表现尚可，一旦进入晚间20:00至23:00的网络流量高峰，国际出口拥堵将直接导致丢包率陡增。而真正采用 IEPL（国际以太网专线）或 IPLC（国际私有租用线路）的服务商，数据直接走陆缆点对点传输，不经过公共国际出口队列，能从物理层根除晚高峰拥堵。
        </p>
        <h3>协议升级：从传统 Shadowsocks 到现代化 VLESS</h3>
        <p>
          随着网络深度包检测（DPI）技术的迭代演进，传统静态特征加密协议（如早期的 Shadowsocks）容易被识别与阻断。现代化协议如 VLESS 配合 XTLS Reality 或 TLS1.3，将代理流量伪装成正常的顶级公网 HTTPS 流量，同时去掉了繁重的双重加密计算开销，不仅极大降低了客户端与服务端延迟，还显著延长了移动设备电池续航。
        </p>
      </div>
    </section>

    <!-- 7. Pillar FAQ Matrix (15 FAQs) -->
    <section class="my-12">
      <FAQAccordion faqs={pFaqs} title="机场大全 专属常见问题解答 (FAQ)" />
    </section>
  </div>
</BaseLayout>
