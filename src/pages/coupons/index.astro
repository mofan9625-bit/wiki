---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BrandCard from "@/components/BrandCard.astro";
import CommercialDisclosure from "@/components/CommercialDisclosure.astro";
import ComparisonTable from "@/components/ComparisonTable.astro";
import DecisionTree from "@/components/DecisionTree.astro";
import FAQAccordion from "@/components/FAQAccordion.astro";
import servicesData from "@/data/services.json";

const pillar = {"id":"coupons","name":"机场优惠码","slug":"coupons","url":"/coupons/","h1":"机场优惠码：真实代码、适用条件与折后费用核算","coreQuestion":"哪些代码适用，优惠后实际支付多少？","theme":"比较购买条件","targetWords":"7,000–9,500 字","duty":"严格围绕优惠码核销，不扩充为杂乱活动新闻。提供真实代码、适用范围、核销限制与到手实付核算。","megaTableCols":["品牌","优惠代码","折扣力度","适用套餐","新老用户资格","最低消费门槛","有效期状态","最后核验时间","直达通道"],"decisionLevels":4,"topics":[{"id":"coupon-verification","name":"优惠查找与资格核对","slug":"coupon-verification","url":"/coupons/coupon-verification/","h1":"优惠查找与资格核对：代码来源、真实性核验与用户资格","desc":"核查公开促销代码与专属内部码的真伪，明确首购限制与续费使用条件。","clusters":[{"id":"code-source-and-trust","name":"代码来源与可信核验","slug":"code-source-and-trust","url":"/coupons/coupon-verification/code-source-and-trust/","h1":"代码来源与可信核验：官方公告、合作渠道与防失效筛查","coreQuestion":"网络上搜索出来的机场优惠码多数失效？如何高效获取官方可用代码？","articles":[{"id":"art-cpo-001","title":"优惠码来源说明"},{"id":"art-cpo-002","title":"优惠码真实性判断"},{"id":"art-cpo-003","title":"优惠码核验方法"},{"id":"art-cpo-004","title":"优惠码失效记录"},{"id":"art-cpo-005","title":"优惠码常见问题"},{"id":"art-cpo-006","title":"代码来源与可信核验完整说明"}]},{"id":"eligibility-and-renewal","name":"首购续费与套餐资格","slug":"eligibility-and-renewal","url":"/coupons/coupon-verification/eligibility-and-renewal/","h1":"首购续费与套餐资格：新用户专属、老用户续费与年付叠加","coreQuestion":"老用户续费能用首购折扣码吗？年付自带的折扣还能叠加优惠码吗？","articles":[{"id":"art-cpo-007","title":"首购优惠码有哪些"},{"id":"art-cpo-008","title":"试用转首购的优惠叠加"},{"id":"art-cpo-009","title":"首购与年付折扣的区别"},{"id":"art-cpo-010","title":"首购优惠码的适用条件"},{"id":"art-cpo-011","title":"续费优惠码有哪些"},{"id":"art-cpo-012","title":"首购续费与套餐资格完整说明"}]}]},{"id":"discount-calculation","name":"折后价格与结算使用","slug":"discount-calculation","url":"/coupons/discount-calculation/","h1":"折后价格与结算使用：实际节省核算、订单验证与防填错","desc":"计算7折/8折/9折后实付金额，指导结算输入位置与金额核对留存。","clusters":[{"id":"discount-and-stacking","name":"优惠折算与叠加规则","slug":"discount-and-stacking","url":"/coupons/discount-calculation/discount-and-stacking/","h1":"优惠折算与叠加规则：7折/8折/9折实际抵扣与总额影响","coreQuestion":"折扣是按原价打折还是折后价再折？怎样算清结算页面的最终支付金额？","articles":[{"id":"art-cpo-013","title":"9 折优惠的实际节省"},{"id":"art-cpo-014","title":"8 折优惠的实际节省"},{"id":"art-cpo-015","title":"7 折优惠的实际节省"},{"id":"art-cpo-016","title":"优惠码叠加规则"},{"id":"art-cpo-017","title":"优惠后实际付款金额"},{"id":"art-cpo-018","title":"优惠折算与叠加规则完整说明"}]},{"id":"checkout-and-evidence","name":"结算验证与订单证据","slug":"checkout-and-evidence","url":"/coupons/discount-calculation/checkout-and-evidence/","h1":"结算验证与订单证据：填写入口、应用提示与报错处理","coreQuestion":"输入优惠码后提示“无效”或“已达上限”怎么处理？如何截图存证？","articles":[{"id":"art-cpo-019","title":"优惠码填写位置说明"},{"id":"art-cpo-020","title":"优惠码结算确认"},{"id":"art-cpo-021","title":"优惠码无法使用的原因"},{"id":"art-cpo-022","title":"优惠码输入错误处理"},{"id":"art-cpo-023","title":"优惠码生效验证"},{"id":"art-cpo-024","title":"结算验证与订单证据完整说明"}]}]},{"id":"change-and-expiration","name":"优惠变更与失效处置","slug":"change-and-expiration","url":"/coupons/change-and-expiration/","h1":"优惠变更与失效处置：升降级影响、过期记录与日常维护","desc":"说明订单变更对既有折扣的影响，建立过期优惠标记与纠错维护机制。","clusters":[{"id":"renewal-order-change","name":"续费与订单变更优惠","slug":"renewal-order-change","url":"/coupons/change-and-expiration/renewal-order-change/","h1":"续费与订单变更优惠：套餐变更折扣延续与补差价规则","coreQuestion":"使用优惠码购买的套餐，后续升级或降级时还能继续享受原折扣吗？","articles":[{"id":"art-cpo-025","title":"续费优惠与首购优惠的差异"},{"id":"art-cpo-026","title":"续费优惠使用步骤"},{"id":"art-cpo-027","title":"续费优惠适用范围"},{"id":"art-cpo-028","title":"订单变更对优惠的影响"},{"id":"art-cpo-029","title":"优惠叠加与订单变更组合"},{"id":"art-cpo-030","title":"续费与订单变更优惠完整说明"}]},{"id":"expiration-maintenance","name":"失效原因与记录维护","slug":"expiration-maintenance","url":"/coupons/change-and-expiration/expiration-maintenance/","h1":"失效原因与记录维护：到期判定、名额限制与动态状态更新","coreQuestion":"站内如何保持优惠码的鲜活性？遇到失效代码如何反馈与纠错？","articles":[{"id":"art-cpo-031","title":"优惠码有效期判断"},{"id":"art-cpo-032","title":"优惠码失效原因"},{"id":"art-cpo-033","title":"优惠码状态更新"},{"id":"art-cpo-034","title":"优惠码失效记录"},{"id":"art-cpo-035","title":"优惠码维护方法"},{"id":"art-cpo-036","title":"失效原因与记录维护完整说明"}]}]}]};
const megaRows = servicesData.map((b: any, index: number) => {
  const isTop1 = b.id === "yunjiexian" || index === 0;
  const targetUrl = `/go.html?id=${b.id}`;

  return [
    b.name,
    isTop1 ? "★ 首选主力专线" : "高性价比备用",
    b.minPayment ? `${b.minPayment} 元/月` : "待核验",
    b.entryPlan || "轻量入门版",
    b.lineType,
    b.protocols,
    b.highlights ? b.highlights[0] : "高速接入",
    b.limitations && b.limitations.length > 0 ? b.limitations[0] : "遵守服务协议",
    {
      text: isTop1 ? "★ 主推入口" : "官网通道",
      url: targetUrl,
      isPrimary: isTop1
    }
  ];
});
const pFaqs = [{"q":"机场优惠码栏目的核心定位与评测依据是什么？","a":"本栏目严格遵从「严格围绕优惠码核销，不扩充为杂乱活动新闻。提供真实代码、适用范围、核销限制与到手实付核算。」。所有推荐均基于真实采集测试证据与公开服务条款，绝不因商业合作调整客观排序。"},{"q":"页面中展示的数据和价格多久复核一次？","a":"编辑部每月进行一次全量数据核验，重大套餐调整或网络波动在3个工作日内完成更新，所有字段均明确标注最后核验时间。"},{"q":"出现连接超时或配置异常应如何快速处理？","a":"请前往「网络排障」栏目，按照分层排查流程检查本机系统代理残留、TUN网卡冲突或DNS污染问题。"},{"q":"本站推荐是否收取品牌方上榜赞助费？","a":"绝不收取任何上榜赞助费。凡含推广返佣链接的卡片均醒目标注，返佣仅作为服务器与测试带宽支出，不影响用户支付价格与评测中立性。"},{"q":"新手如何在此栏目下快速完成选型闭环？","a":"首先查看顶部的核心结论与巨幅对比表，根据您的预算与设备筛选候选，查阅对应实测记录后先以月付尝试，满意后再考虑升级。"}];
const decisionTreeText = `[ 机场优惠码 场景决策模型 ]
  │
  ├── 追求极致稳定性与晚高峰生产力 ───────> 首选：云界线 (IEPL专线 + VLESS)
  │     ├── 需要高稳定专线 + 低预算门槛 ───> 首选：云界线 (折算约5.6元/月起)
  │     └── 多人多设备高并发办公 ─────────> 神行加速 / 闪电鼠
  │
  ├── 严格控制预算 / 轻度查资料 / 备用 ───> 方案：大佬云 / 环球梯 / 榴莲云
  │     └── 月均支出仅 5–8 元区间 ────────> 年付折算或轻度小流量
  │
  └── 遇到网络连接中断或配置疑问 ─────────> 直达：网络排障 (/troubleshooting/)`;
---

<BaseLayout
  title="机场优惠码：从使用需求到具体品牌的选购指南 - 机场wiki指南"
  description="机场优惠码：真实代码、适用条件与折后费用核算。全面涵盖核心候选对比、使用限制、实测证据、巨幅对比表、ASCII决策树与下辖36篇深度指南。"
  canonicalUrl="https://jichangwiki.cc/coupons/"
  breadcrumbs={[
    { name: "首页", url: "/" },
    { name: "机场优惠码", url: "/coupons/" }
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header Hero -->
    <div class="border-b border-slate-200 pb-8 mb-8">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-800 mb-3">
        <span>一级栏目 Pillar Hub · 万字级权威指南</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">
        机场优惠码：真实代码、适用条件与折后费用核算
      </h1>
      <p class="text-lg text-slate-600 leading-relaxed max-w-4xl">
        <strong>核心解答：</strong>哪些代码适用，优惠后实际支付多少？ 本栏目严格遵循「严格围绕优惠码核销，不扩充为杂乱活动新闻。提供真实代码、适用范围、核销限制与到手实付核算。」，拒绝夸大其词，用翔实数据支撑明智决策。
      </p>
    </div>

    <!-- Commercial Transparency Banner -->
    <CommercialDisclosure />

    <!-- 1. Answer-First Section -->
    <section class="my-10 bg-blue-50/50 rounded-2xl p-6 sm:p-8 border border-blue-100">
      <h2 class="text-xl font-bold text-blue-950 mb-3">答案优先：当前场景核心选型结论</h2>
      <p class="text-base text-slate-700 leading-relaxed mb-4">
        对于绝大多数追求稳定性的日常与办公用户，首选应为具备成熟运营历史、全专线架构且支持现代化 VLESS 协议的服务商（如本站主推的<strong>云界线</strong>）。低预算与备用场景可选用 5–8 元月付的轻量方案。选购的核心原则是：<strong>先明确真实月流量需求与关键工具（如ChatGPT/流媒体），首选月付验证，晚高峰实测达标后再行决定是否续约</strong>。
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm">
        <div class="bg-white p-3.5 rounded-xl border border-blue-200">
          <strong class="text-emerald-700 block mb-1">✓ 适合人群：</strong>
          需要跨境学术科研、外贸出海沟通、AI生产力辅助及海外4K流媒体播放的合规用户。
        </div>
        <div class="bg-white p-3.5 rounded-xl border border-blue-200">
          <strong class="text-amber-700 block mb-1">✗ 不适合人群：</strong>
          抱有“几块钱永久不限速无限用”不切实际幻想、或试图利用网络规避审查与非法操作者。
        </div>
      </div>
    </section>

    <!-- 2. ASCII Decision Tree -->
    <section class="my-10">
      <h2 class="text-2xl font-bold text-slate-900 mb-2">快速选择决策树</h2>
      <p class="text-sm text-slate-500 mb-4">通过三层逻辑分支直接对齐您的预算与任务诉求：</p>
      <DecisionTree treeText={decisionTreeText} />
    </section>

    <!-- 3. Mega Comparison Table -->
    <section class="my-10">
      <h2 class="text-2xl font-bold text-slate-900 mb-2">巨幅综合横向对比大盘</h2>
      <p class="text-sm text-slate-500 mb-4">6 家核心品牌横向对比大盘（支持横向滑动）：</p>
      <ComparisonTable
        headers={pillar.megaTableCols}
        rows={megaRows}
        caption="机场优惠码 核心候选横向对比表"
      />
    </section>

            <!-- 4. Featured Brand Showcase -->
    <section class="my-10">
      <h2 class="text-2xl font-bold text-slate-900 mb-4">精选代表性服务商深度剖析</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {servicesData.map((b: any) => (
          <BrandCard
            brand={b}
            featuredReason={
              b.id === "yunjiexian" ? "2024年稳定运营，全IEPL专线，低预算首选主力方案" :
              b.id === "dalaoyun" ? "超低预算IEPL专线，高性价比备用首选" :
              b.id === "huanqiuti" ? "经济型轻度专线服务，高性价比备用方案" :
              b.id === "liulianyun" ? "超经济专线中继，轻量备用高性价比之选" :
              b.id === "shandianshu" ? "轻量级低资费专线服务，5.6元/月极致入门备用" :
              b.id === "shenxing" ? "平价大容量IEPL专线，120GB月配额高性价比备用" :
              (b.isPrimaryRecommendation ? "综合性能标杆，全IEPL专线保障晚高峰低丢包" : "性价比专线接入")
            }
          />
        ))}
      </div>
    </section>

    <!-- 5. Under-Pillar Topics & Articles Structure (Honeycomb Links) -->
    <section class="my-12 bg-slate-50 rounded-2xl p-6 sm:p-8 border border-slate-200">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-2xl font-bold text-slate-900">下辖 3 个二级专题与 36 篇深度文章</h2>
          <p class="text-sm text-slate-500 mt-1">蜂巢式内链立体覆盖，可根据具体痛点直达细分指导：</p>
        </div>
        <a href="/sitemap/" class="text-xs font-semibold text-blue-600 hover:underline">
          查阅全站地图 →
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {pillar.topics.map((t: any, tIdx: number) => (
          <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-sm flex flex-col justify-between">
            <div>
              <div class="text-[11px] font-mono font-bold text-blue-600 mb-1">
                专题 0{tIdx + 1}
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">
                <a href={t.url} class="text-slate-900 hover:text-blue-600 transition-colors no-underline">
                  {t.name}
                </a>
              </h3>
              <p class="text-xs text-slate-500 mb-4 leading-relaxed">
                {t.desc}
              </p>

              <!-- Clusters & Articles List -->
              <div class="space-y-3">
                {t.clusters.map((c: any) => (
                  <div class="border-t border-slate-100 pt-2.5">
                    <div class="text-xs font-bold text-slate-800 mb-1.5 flex items-center justify-between">
                      <a href={c.url} class="hover:text-blue-600 transition-colors no-underline">
                        {c.name}
                      </a>
                      <span class="text-[10px] text-slate-400 font-mono">6篇</span>
                    </div>
                    <ul class="space-y-1 text-xs text-slate-600">
                      {c.articles.slice(0, 3).map((art: any) => (
                        <li class="truncate flex items-start space-x-1">
                          <span class="text-blue-500 shrink-0">·</span>
                          <a href={`/articles/${art.id}/`} class="hover:text-blue-600 truncate" title={art.title}>
                            {art.title}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 text-right">
              <a href={t.url} class="text-xs font-semibold text-blue-600 hover:underline">
                浏览此专题完整 12 篇 →
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 6. Long-form In-depth Guide -->
    <section class="my-12">
      <div class="article-content max-w-none">
        <h2>底层机制剖析与选型关键依据</h2>
        <p>
          在选择网络加速服务时，用户往往容易被标称的“峰值带宽”所误导。实际上，决定日常使用顺畅度的三大核心指标并非单线程下载峰值，而是<strong>端到端RTT延迟抖动、晚高峰丢包率与TCP重传率</strong>。
        </p>
        <h3>专线与普通直连的本质鸿沟</h3>
        <p>
          国际互联网出口受国家级骨干网防火墙检测与国际海缆带宽配额限制。普通公网直连（如普通BGP中转）在平峰期表现尚可，一旦进入晚间20:00至23:00的网络流量高峰，国际出口拥堵将直接导致丢包率陡增。而真正采用 IEPL（国际以太网专线）或 IPLC（国际私有租用线路）的服务商，数据直接走陆缆点对点传输，不经过公共国际出口队列，能从物理层根除晚高峰拥堵。
        </p>
        <h3>协议升级：从传统 Shadowsocks 到现代化 VLESS</h3>
        <p>
          随着网络深度包检测（DPI）技术的迭代演进，传统静态特征加密协议（如早期的 Shadowsocks）容易被识别与阻断。现代化协议如 VLESS 配合 XTLS Reality 或 TLS1.3，将代理流量伪装成正常的顶级公网 HTTPS 流量，同时去掉了繁重的双重加密计算开销，不仅极大降低了客户端与服务端延迟，还显著延长了移动设备电池续航。
        </p>
      </div>
    </section>

    <!-- 7. Pillar FAQ Matrix (15 FAQs) -->
    <section class="my-12">
      <FAQAccordion faqs={pFaqs} title="机场优惠码 专属常见问题解答 (FAQ)" />
    </section>
  </div>
</BaseLayout>
