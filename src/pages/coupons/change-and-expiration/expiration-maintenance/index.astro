const pillar = {"id":"coupons","name":"机场优惠码","slug":"coupons","url":"/coupons/","h1":"机场优惠码：真实代码、适用条件与折后费用核算","coreQuestion":"哪些代码适用，优惠后实际支付多少？","theme":"比较购买条件","targetWords":"7,000–9,500 字","duty":"严格围绕优惠码核销，不扩充为杂乱活动新闻。提供真实代码、适用范围、核销限制与到手实付核算。","megaTableCols":["品牌","优惠代码","折扣力度","适用套餐","新老用户资格","最低消费门槛","有效期状态","最后核验时间","直达通道"],"decisionLevels":4,"topics":[{"id":"coupon-verification","name":"优惠查找与资格核对","slug":"coupon-verification","url":"/coupons/coupon-verification/","h1":"优惠查找与资格核对：代码来源、真实性核验与用户资格","desc":"核查公开促销代码与专属内部码的真伪，明确首购限制与续费使用条件。","clusters":[{"id":"code-source-and-trust","name":"代码来源与可信核验","slug":"code-source-and-trust","url":"/coupons/coupon-verification/code-source-and-trust/","h1":"代码来源与可信核验：官方公告、合作渠道与防失效筛查","coreQuestion":"网络上搜索出来的机场优惠码多数失效？如何高效获取官方可用代码？","articles":[{"id":"art-cpo-001","title":"优惠码来源说明"},{"id":"art-cpo-002","title":"优惠码真实性判断"},{"id":"art-cpo-003","title":"优惠码核验方法"},{"id":"art-cpo-004","title":"优惠码失效记录"},{"id":"art-cpo-005","title":"优惠码常见问题"},{"id":"art-cpo-006","title":"代码来源与可信核验完整说明"}]},{"id":"eligibility-and-renewal","name":"首购续费与套餐资格","slug":"eligibility-and-renewal","url":"/coupons/coupon-verification/eligibility-and-renewal/","h1":"首购续费与套餐资格：新用户专属、老用户续费与年付叠加","coreQuestion":"老用户续费能用首购折扣码吗？年付自带的折扣还能叠加优惠码吗？","articles":[{"id":"art-cpo-007","title":"首购优惠码有哪些"},{"id":"art-cpo-008","title":"试用转首购的优惠叠加"},{"id":"art-cpo-009","title":"首购与年付折扣的区别"},{"id":"art-cpo-010","title":"首购优惠码的适用条件"},{"id":"art-cpo-011","title":"续费优惠码有哪些"},{"id":"art-cpo-012","title":"首购续费与套餐资格完整说明"}]}]},{"id":"discount-calculation","name":"折后价格与结算使用","slug":"discount-calculation","url":"/coupons/discount-calculation/","h1":"折后价格与结算使用：实际节省核算、订单验证与防填错","desc":"计算7折/8折/9折后实付金额，指导结算输入位置与金额核对留存。","clusters":[{"id":"discount-and-stacking","name":"优惠折算与叠加规则","slug":"discount-and-stacking","url":"/coupons/discount-calculation/discount-and-stacking/","h1":"优惠折算与叠加规则：7折/8折/9折实际抵扣与总额影响","coreQuestion":"折扣是按原价打折还是折后价再折？怎样算清结算页面的最终支付金额？","articles":[{"id":"art-cpo-013","t