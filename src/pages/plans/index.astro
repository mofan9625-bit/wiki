---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BrandCard from "@/components/BrandCard.astro";
import CommercialDisclosure from "@/components/CommercialDisclosure.astro";
import ComparisonTable from "@/components/ComparisonTable.astro";
import DecisionTree from "@/components/DecisionTree.astro";
import FAQAccordion from "@/components/FAQAccordion.astro";
import servicesData from "@/data/services.json";

const pillar = {"id":"plans","name":"套餐对比","slug":"plans","url":"/plans/","h1":"机场套餐对比：付款周期、流量计量与总成本计算","coreQuestion":"这些套餐的价格和规则，应该怎样放在同一个口径下比较？","theme":"比较购买条件","targetWords":"7,000–9,500 字","duty":"比较单位是具体套餐，而不是只列品牌最低价。横向打通周期、倍率、有效期与升降级退款规则。","megaTableCols":["套餐全称","所属品牌","实际付款金额","计费周期","流量额度","流量重置方式","倍率区间","设备并发限制","核验状态"],"decisionLevels":4,"topics":[{"id":"billing-cycles","name":"付款周期与流量包","slug":"billing-cycles","url":"/plans/billing-cycles/","h1":"付款周期与流量包：月付季付年付与不限时按量规则","desc":"比较各计费周期的灵活性与实际总额，解析不限时流量包与账户有效期的法律约束。","clusters":[{"id":"cycle-comparison","name":"月付季付与年付","slug":"cycle-comparison","url":"/plans/billing-cycles/cycle-comparison/","h1":"月付季付与年付：支出模型、周期灵活性与匹配原则","coreQuestion":"月付、季付、年付该怎么比？怎样平衡资金占用与折扣力度？","articles":[{"id":"art-plan-001","title":"月付、季付、年付的对比方法"},{"id":"art-plan-002","title":"不同付款周期的总支出计算"},{"id":"art-plan-003","title":"付款周期与使用频率匹配"},{"id":"art-plan-004","title":"付款周期与灵活性的取舍"},{"id":"art-plan-005","title":"付款周期选择决策框架"},{"id":"art-plan-006","title":"月付、季付与年付完整对比"}]},{"id":"non-expiring-and-metered","name":"不限时与按量规则","slug":"non-expiring-and-metered","url":"/plans/billing-cycles/non-expiring-and-metered/","h1":"不限时与按量规则：流量与账户有效期分离、叠加与补购","coreQuestion":"所谓不限时流量包真的永远不过期吗？多个流量包叠加后如何扣费？","articles":[{"id":"art-plan-007","title":"不限时机场套餐是什么意思？流量有效期与账户有效期需要分开看"},{"id":"art-plan-008","title":"按量付费机场怎样计算每GB成本？加入倍率与附加费用的比较方法"},{"id":"art-plan-009","title":"不限时流量包与月付套餐的盈亏平衡点怎么算？"},{"id":"art-plan-010","title":"多个不限时流量包叠加后先扣哪一份？购买前核对消耗顺序"},{"id":"art-plan-011","title":"机场流量包有到期日还算不限时吗？识别宣传名称与实际规则"},{"id":"art-plan-012","title":"流量包用完后补购还是改月付？根据后续用量重新计算"}]}]},{"id":"metering-and-limits","name":"流量计量与使用限制","slug":"metering-and-limits","url":"/plans/metering-and-limits/","h1":"流量计量与使用限制：倍率机制、重置周期与并发限制","desc":"详细核对GB与GiB口径、单向与双向扣费、设备连接上限与限速规则。","clusters":[{"id":"rate-multiplier-and-units","name":"额度单位与流量倍率","slug":"rate-multiplier-and-units","url":"/plans/metering-and-limits/rate-multiplier-and-units/","h1":"额度单位与流量倍率：上下行计费、重置日与耗尽熔断","coreQuestion":"为什么看了一个10GB视频却扣了30GB流量？如何核验节点倍率？","articles":[{"id":"art-plan-013","title":"流量计量口径说明：原始单位与统计方式"},{"id":"art-plan-014","title":"流量倍率的应用与影响"},{"id":"art-plan-015","title":"上下行计费的差异"},{"id":"art-plan-016","title":"流量重置周期的说明"},{"id":"art-plan-017","title":"流量耗尽后的处理规则"},{"id":"art-plan-018","title":"额度单位与流量倍率完整对比"}]},{"id":"speed-limit-concurrency","name":"限速并发与设备规则","slug":"speed-limit-concurrency","url":"/plans/metering-and-limits/speed-limit-concurrency/","h1":"限速并发与设备规则：连接数、带宽峰值与多端限制","coreQuestion":"套餐标明不限设备，为什么宿舍多几个人连就频繁断线？","articles":[{"id":"art-plan-019","title":"客户端兼容性对比"},{"id":"art-plan-020","title":"协议支持对比"},{"id":"art-plan-021","title":"设备数量限制对比"},{"id":"art-plan-022","title":"并发连接限制对比"},{"id":"art-plan-023","title":"附加功能对比"},{"id":"art-plan-024","title":"限速并发与设备规则完整说明"}]}]},{"id":"plan-management","name":"套餐变更与权益管理","slug":"plan-management","url":"/plans/plan-management/","h1":"套餐变更与权益管理：补差价升级、续费及余额处置","desc":"规范升级降级折算方法、未到期退款申请与废弃账号余额处置流程。","clusters":[{"id":"upgrade-downgrade-diff","name":"升级降级与补差价","slug":"upgrade-downgrade-diff","url":"/plans/plan-management/upgrade-downgrade-diff/","h1":"升级降级与补差价：生效时间、折算规则与流量重置","coreQuestion":"月中流量不够用了，补差价升级套餐是立即生效还是下月生效？","articles":[{"id":"art-plan-025","title":"套餐升级方法与注意事项"},{"id":"art-plan-026","title":"套餐降级方法与限制"},{"id":"art-plan-027","title":"升级降级的补差价计算"},{"id":"art-plan-028","title":"套餐变更的生效时间"},{"id":"art-plan-029","title":"套餐变更的影响范围"},{"id":"art-plan-030","title":"升级降级完整说明"}]},{"id":"renewal-stop-balance","name":"续费停止与余额处置","slug":"renewal-stop-balance","url":"/plans/plan-management/renewal-stop-balance/","h1":"续费停止与余额处置：到期停机、退款核验与剩余资产清算","coreQuestion":"不再使用该机场后，账户里的充值余额能不能原路提现退款？","articles":[{"id":"art-plan-031","title":"套餐续费方法"},{"id":"art-plan-032","title":"套餐停止使用流程"},{"id":"art-plan-033","title":"余额与流量处置规则"},{"id":"art-plan-034","title":"退款政策核对"},{"id":"art-plan-035","title":"续费与停止的影响说明"},{"id":"art-plan-036","title":"续费停止与余额处置完整说明"}]}]}]};
const megaRows = servicesData.map((b: any, index: number) => {
  const isTop1 = b.id === "yunjiexian" || index === 0;
  const targetUrl = b.registerUrl && b.registerUrl.startsWith("http")
    ? b.registerUrl
    : `/airports/${b.id}/`;

  return [
    b.name,
    isTop1 ? "★ 首选主力专线" : "高性价比备用",
    b.minPayment ? `${b.minPayment} 元/月` : "待核验",
    b.entryPlan || "轻量入门版",
    b.lineType,
    b.protocols,
    b.highlights ? b.highlights[0] : "高速接入",
    b.limitations && b.limitations.length > 0 ? b.limitations[0] : "遵守服务协议",
    {
      text: isTop1 ? "★ 主推入口" : "官网通道",
      url: targetUrl,
      isPrimary: isTop1
    }
  ];
});
const pFaqs = [{"q":"套餐对比栏目的核心定位与评测依据是什么？","a":"本栏目严格遵从「比较单位是具体套餐，而不是只列品牌最低价。横向打通周期、倍率、有效期与升降级退款规则。」。所有推荐均基于真实采集测试证据与公开服务条款，绝不因商业合作调整客观排序。"},{"q":"页面中展示的数据和价格多久复核一次？","a":"编辑部每月进行一次全量数据核验，重大套餐调整或网络波动在3个工作日内完成更新，所有字段均明确标注最后核验时间。"},{"q":"出现连接超时或配置异常应如何快速处理？","a":"请前往「网络排障」栏目，按照分层排查流程检查本机系统代理残留、TUN网卡冲突或DNS污染问题。"},{"q":"本站推荐是否收取品牌方上榜赞助费？","a":"绝不收取任何上榜赞助费。凡含推广返佣链接的卡片均醒目标注，返佣仅作为服务器与测试带宽支出，不影响用户支付价格与评测中立性。"},{"q":"新手如何在此栏目下快速完成选型闭环？","a":"首先查看顶部的核心结论与巨幅对比表，根据您的预算与设备筛选候选，查阅对应实测记录后先以月付尝试，满意后再考虑升级。"}];
const decisionTreeText = `[ 套餐对比 场景决策模型 ]
  │
  ├── 追求极致稳定性与晚高峰生产力 ───────> 首选：云界线 (IEPL专线 + VLESS)
  │     ├── 需要高稳定专线 + 低预算门槛 ───> 首选：云界线 (折算约5.6元/月起)
  │     └── 多人多设备高并发办公 ─────────> 神行加速 / 闪电鼠
  │
  ├── 严格控制预算 / 轻度查资料 / 备用 ───> 方案：大佬云 / 环球梯 / 榴莲云
  │     └── 月均支出仅 5–8 元区间 ────────> 年付折算或轻度小流量
  │
  └── 遇到网络连接中断或配置疑问 ─────────> 直达：网络排障 (/troubleshooting/)`;
---

<BaseLayout
  title="套餐对比：从使用需求到具体品牌的选购指南 - 机场wiki指南"
  description="机场套餐对比：付款周期、流量计量与总成本计算。全面涵盖核心候选对比、使用限制、实测证据、巨幅对比表、ASCII决策树与下辖36篇深度指南。"
  canonicalUrl="https://jichangwiki.cc/plans/"
  breadcrumbs={[
    { name: "首页", url: "/" },
    { name: "套餐对比", url: "/plans/" }
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header Hero -->
    <div class="border-b border-slate-200 pb-8 mb-8">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-800 mb-3">
        <span>一级栏目 Pillar Hub · 万字级权威指南</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">
        机场套餐对比：付款周期、流量计量与总成本计算
      </h1>
      <p class="text-lg text-slate-600 leading-relaxed max-w-4xl">
        <strong>核心解答：</strong>这些套餐的价格和规则，应该怎样放在同一个口径下比较？ 本栏目严格遵循「比较单位是具体套餐，而不是只列品牌最低价。横向打通周期、倍率、有效期与升降级退款规则。」，拒绝夸大其词，用翔实数据支撑明智决策。
      </p>
    </div>

    <!-- Commercial Transparency Banner -->
    <CommercialDisclosure />

    <!-- 1. Answer-First Section -->
    <section class="my-10 bg-blue-50/50 rounded-2xl p-6 sm:p-8 border border-blue-100">
      <h2 class="text-xl font-bold text-blue-950 mb-3">答案优先：当前场景核心选型结论</h2>
      <p class="text-base text-slate-700 leading-relaxed mb-4">
        对于绝大多数追求稳定性的日常与办公用户，首选应为具备成熟运营历史、全专线架构且支持现代化 VLESS 协议的服务商（如本站主推的<strong>云界线</strong>）。低预算与备用场景可选用 5–8 元月付的轻量方案。选购的核心原则是：<strong>先明确真实月流量需求与关键工具（如ChatGPT/流媒体），首选月付验证，晚高峰实测达标后再行决定是否续约</strong>。
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm">
        <div class="bg-white p-3.5 rounded-xl border border-blue-200">
          <strong class="text-emerald-700 block mb-1">✓ 适合人群：</strong>
          需要跨境学术科研、外贸出海沟通、AI生产力辅助及海外4K流媒体播放的合规用户。
        </div>
        <div class="bg-white p-3.5 rounded-xl border border-blue-200">
          <strong class="text-amber-700 block mb-1">✗ 不适合人群：</strong>
          抱有“几块钱永久不限速无限用”不切实际幻想、或试图利用网络规避审查与非法操作者。
        </div>
      </div>
    </section>

    <!-- 2. ASCII Decision Tree -->
    <section class="my-10">
      <h2 class="text-2xl font-bold text-slate-900 mb-2">快速选择决策树</h2>
      <p class="text-sm text-slate-500 mb-4">通过三层逻辑分支直接对齐您的预算与任务诉求：</p>
      <DecisionTree treeText={decisionTreeText} />
    </section>

    <!-- 3. Mega Comparison Table -->
    <section class="my-10">
      <h2 class="text-2xl font-bold text-slate-900 mb-2">巨幅综合横向对比大盘</h2>
      <p class="text-sm text-slate-500 mb-4">6 家核心品牌横向对比大盘（支持横向滑动）：</p>
      <ComparisonTable
        headers={pillar.megaTableCols}
        rows={megaRows}
        caption="套餐对比 核心候选横向对比表"
      />
    </section>

            <!-- 4. Featured Brand Showcase -->
    <section class="my-10">
      <h2 class="text-2xl font-bold text-slate-900 mb-4">精选代表性服务商深度剖析</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {servicesData.map((b: any) => (
          <BrandCard
            brand={b}
            featuredReason={
              b.id === "yunjiexian" ? "2024年稳定运营，全IEPL专线，低预算首选主力方案" :
              b.id === "dalaoyun" ? "超低预算IEPL专线，高性价比备用首选" :
              b.id === "huanqiuti" ? "经济型轻度专线服务，高性价比备用方案" :
              b.id === "liulianyun" ? "超经济专线中继，轻量备用高性价比之选" :
              b.id === "shandianshu" ? "轻量级低资费专线服务，5.6元/月极致入门备用" :
              b.id === "shenxing" ? "平价大容量IEPL专线，120GB月配额高性价比备用" :
              (b.isPrimaryRecommendation ? "综合性能标杆，全IEPL专线保障晚高峰低丢包" : "性价比专线接入")
            }
          />
        ))}
      </div>
    </section>

    <!-- 5. Under-Pillar Topics & Articles Structure (Honeycomb Links) -->
    <section class="my-12 bg-slate-50 rounded-2xl p-6 sm:p-8 border border-slate-200">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-2xl font-bold text-slate-900">下辖 3 个二级专题与 36 篇深度文章</h2>
          <p class="text-sm text-slate-500 mt-1">蜂巢式内链立体覆盖，可根据具体痛点直达细分指导：</p>
        </div>
        <a href="/sitemap/" class="text-xs font-semibold text-blue-600 hover:underline">
          查阅全站地图 →
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {pillar.topics.map((t: any, tIdx: number) => (
          <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-sm flex flex-col justify-between">
            <div>
              <div class="text-[11px] font-mono font-bold text-blue-600 mb-1">
                专题 0{tIdx + 1}
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">
                <a href={t.url} class="text-slate-900 hover:text-blue-600 transition-colors no-underline">
                  {t.name}
                </a>
              </h3>
              <p class="text-xs text-slate-500 mb-4 leading-relaxed">
                {t.desc}
              </p>

              <!-- Clusters & Articles List -->
              <div class="space-y-3">
                {t.clusters.map((c: any) => (
                  <div class="border-t border-slate-100 pt-2.5">
                    <div class="text-xs font-bold text-slate-800 mb-1.5 flex items-center justify-between">
                      <a href={c.url} class="hover:text-blue-600 transition-colors no-underline">
                        {c.name}
                      </a>
                      <span class="text-[10px] text-slate-400 font-mono">6篇</span>
                    </div>
                    <ul class="space-y-1 text-xs text-slate-600">
                      {c.articles.slice(0, 3).map((art: any) => (
                        <li class="truncate flex items-start space-x-1">
                          <span class="text-blue-500 shrink-0">·</span>
                          <a href={`/articles/${art.id}/`} class="hover:text-blue-600 truncate" title={art.title}>
                            {art.title}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 text-right">
              <a href={t.url} class="text-xs font-semibold text-blue-600 hover:underline">
                浏览此专题完整 12 篇 →
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 6. Long-form In-depth Guide -->
    <section class="my-12">
      <div class="article-content max-w-none">
        <h2>底层机制剖析与选型关键依据</h2>
        <p>
          在选择网络加速服务时，用户往往容易被标称的“峰值带宽”所误导。实际上，决定日常使用顺畅度的三大核心指标并非单线程下载峰值，而是<strong>端到端RTT延迟抖动、晚高峰丢包率与TCP重传率</strong>。
        </p>
        <h3>专线与普通直连的本质鸿沟</h3>
        <p>
          国际互联网出口受国家级骨干网防火墙检测与国际海缆带宽配额限制。普通公网直连（如普通BGP中转）在平峰期表现尚可，一旦进入晚间20:00至23:00的网络流量高峰，国际出口拥堵将直接导致丢包率陡增。而真正采用 IEPL（国际以太网专线）或 IPLC（国际私有租用线路）的服务商，数据直接走陆缆点对点传输，不经过公共国际出口队列，能从物理层根除晚高峰拥堵。
        </p>
        <h3>协议升级：从传统 Shadowsocks 到现代化 VLESS</h3>
        <p>
          随着网络深度包检测（DPI）技术的迭代演进，传统静态特征加密协议（如早期的 Shadowsocks）容易被识别与阻断。现代化协议如 VLESS 配合 XTLS Reality 或 TLS1.3，将代理流量伪装成正常的顶级公网 HTTPS 流量，同时去掉了繁重的双重加密计算开销，不仅极大降低了客户端与服务端延迟，还显著延长了移动设备电池续航。
        </p>
      </div>
    </section>

    <!-- 7. Pillar FAQ Matrix (15 FAQs) -->
    <section class="my-12">
      <FAQAccordion faqs={pFaqs} title="套餐对比 专属常见问题解答 (FAQ)" />
    </section>
  </div>
</BaseLayout>
