const topicArticles = [{"id":"art-plan-025","title":"套餐升级方法与注意事项","clusterName":"升级降级与补差价"},{"id":"art-plan-026","title":"套餐降级方法与限制","clusterName":"升级降级与补差价"},{"id":"art-plan-027","title":"升级降级的补差价计算","clusterName":"升级降级与补差价"},{"id":"art-plan-028","title":"套餐变更的生效时间","clusterName":"升级降级与补差价"},{"id":"art-plan-029","title":"套餐变更的影响范围","clusterName":"升级降级与补差价"},{"id":"art-plan-030","title":"升级降级完整说明","clusterName":"升级降级与补差价"},{"id":"art-plan-031","title":"套餐续费方法","clusterName":"续费停止与余额处置"},{"id":"art-plan-032","title":"套餐停止使用流程","clusterName":"续费停止与余额处置"},{"id":"art-plan-033","title":"余额与流量处置规则","clusterName":"续费停止与余额处置"},{"id":"art-plan-034","title":"退款政策核对","clusterName":"续费停止与余额处置"},{"id":"art-plan-035","title":"续费与停止的影响说明","clusterName":"续费停止与余额处置"},{"id":"art-plan-036","title":"续费停止与余额处置完整说明","clusterName":"续费停止与余额处置"}];
const topicFaqs = [{"q":"本专题下的两个子集群分别解决什么问题？","a":"子集群「升级降级与补差价」着重解决基础选型与前置决策；子集群「续费停止与余额处置」解决进阶配置与主备协同，二者构成完整方案闭环。"},{"q":"阅读本专题文章需要按顺序看吗？","a":"建议先阅读各子集群的核心总解，随后根据您当前遇到的具体阻碍（如换机场、移动网络或多端协作）查阅对应文章。"},{"q":"专题推荐结论与具体文章冲突时以什么为准？","a":"专题提供宏观场景判断，具体文章针对具体任务给出微观演算。所有数据均受统一的实测基线核验支撑。"}];
---

<BaseLayout
  title="套餐变更与权益管理：套餐变更与权益管理：补差价升级、续费及余额处置 - 机场wiki指南"
  description="规范升级降级折算方法、未到期退款申请与废弃账号余额处置流程。 涵盖两个子集群与12篇精选实测文章。"
  canonicalUrl="https://jichangwiki.cc/plans/plan-management/"
  breadcrumbs={[
    { name: "首页", url: "/" },
    { name: "套餐对比", url: "/plans/" },
    { name: "套餐变更与权益管理", url: "/plans/plan-management/" }
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="border-b border-slate-200 pb-6 mb-8">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-800 mb-3">
        <span>所属栏目：套餐对比 · 二级专题</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-3">
        套餐变更与权益管理：补差价升级、续费及余额处置
      </h1>
      <p class="text-base sm:text-lg text-slate-600 max-w-3xl leading-relaxed">
        规范升级降级折算方法、未到期退款申请与废弃账号余额处置流程。
      </p>
    </div>

    <CommercialDisclosure compact={true} />

    <!-- Two Clusters Overview -->
    <section class="my-8 grid grid-cols-1 md:grid-cols-2 gap-6">
      {topic.clusters.map((c: any, cIdx: number) => (
        <div class="card p-6 bg-slate-50 border-slate-200">
          <div class="text-xs font-bold font-mono text-blue-600 mb-1">
            子集群 0{cIdx + 1}
          </div>
          <h2 class="text-xl font-bold text-slate-900 mb-2">
            <a href={c.url} class="text-slate-900 hover:text-blue-600 no-underline">
              {c.name}
            </a>
          </h2>
          <p class="text-xs text-slate-600 mb-4 leading-relaxed">
            <strong>主问题：</strong>{c.coreQuestion}
          </p>
          <a
            href={c.url}
            class="text-xs font-semibold text-blue-600 hover:underline inline-flex items-center space-x-1"
          >
            <span>进入集群总解与阅读顺序</span>
            <span>→</span>
          </a>
        </div>
      ))}
    </section>

    <!-- 12 Articles Grid -->
    <section class="my-10">
      <div class="flex items-center justify-between mb-4 pb-2 border-b border-slate-200">
        <h2 class="text-xl font-bold text-slate-900">本专题下辖全部 12 篇发布文章</h2>
        <span class="text-xs text-slate-400">稳定 ID 映射 · 无字面重复</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {topicArticles.map((a: any) => (
          <ArticleCard
            id={a.id}
            title={a.title}
            url={`/articles/${a.id}/`}
            clusterName={a.clusterName}
          />
        ))}
      </div>
    </section>

    <!-- Topic FAQs -->
    <section class="my-10">
      <FAQAccordion faqs={topicFaqs} title="套餐变更与权益管理 专题常见疑问" />
    </section>
  </div>
</BaseLayout>
