const pillar = {"id":"plans","name":"套餐对比","slug":"plans","url":"/plans/","h1":"机场套餐对比：付款周期、流量计量与总成本计算","coreQuestion":"这些套餐的价格和规则，应该怎样放在同一个口径下比较？","theme":"比较购买条件","targetWords":"7,000–9,500 字","duty":"比较单位是具体套餐，而不是只列品牌最低价。横向打通周期、倍率、有效期与升降级退款规则。","megaTableCols":["套餐全称","所属品牌","实际付款金额","计费周期","流量额度","流量重置方式","倍率区间","设备并发限制","核验状态"],"decisionLevels":4,"topics":[{"id":"billing-cycles","name":"付款周期与流量包","slug":"billing-cycles","url":"/plans/billing-cycles/","h1":"付款周期与流量包：月付季付年付与不限时按量规则","desc":"比较各计费周期的灵活性与实际总额，解析不限时流量包与账户有效期的法律约束。","clusters":[{"id":"cycle-comparison","name":"月付季付与年付","slug":"cycle-comparison","url":"/plans/billing-cycles/cycle-comparison/","h1":"月付季付与年付：支出模型、周期灵活性与匹配原则","coreQuestion":"月付、季付、年付该怎么比？怎样平衡资金占用与折扣力度？","articles":[{"id":"art-plan-001","title":"月付、季付、年付的对比方法"},{"id":"art-plan-002","title":"不同付款周期的总支出计算"},{"id":"art-plan-003","title":"付款周期与使用频率匹配"},{"id":"art-plan-004","title":"付款周期与灵活性的取舍"},{"id":"art-plan-005","title":"付款周期选择决策框架"},{"id":"art-plan-006","title":"月付、季付与年付完整对比"}]},{"id":"non-expiring-and-metered","name":"不限时与按量规则","slug":"non-expiring-and-metered","url":"/plans/billing-cycles/non-expiring-and-metered/","h1":"不限时与按量规则：流量与账户有效期分离、叠加与补购","coreQuestion":"所谓不限时流量包真的永远不过期吗？多个流量包叠加后如何扣费？","articles":[{"id":"art-plan-007","title":"不限时机场套餐是什么意思？流量有效期与账户有效期需要分开看"},{"id":"art-plan-008","title":"按量付费机场怎样计算每GB成本？加入倍率与附加费用的比较方法"},{"id":"art-plan-009","title":"不限时流量包与月付套餐的盈亏平衡点怎么算？"},{"id":"art-plan-010","title":"多个不限时流量包叠加后先扣哪一份？购买前核对消耗顺序"},{"id":"art-plan-011","title":"机场流量包有到期日还算不限时吗？识别宣传名称与实际规则"},{"id":"art-plan-012","title":"流量包用完后补购还是改月付？根据后续用量重新计算"}]}]},{"id":"metering-and-limits","name":"流量计量与使用限制","slug":"metering-and-limits","url":"/plans/metering-and-limits/","h1":"流量计量与使用限制：倍率机制、重置周期与并发限制","desc":"详细核对GB与GiB口径、单向与双向扣费、设备连接上限与限速规则。","clusters":[{"id":"rate-multiplier-and-units","name":"额度单位与流量倍率","slug":"rate-multiplier-and-units","url":"/plans/metering-and-limits/rate-multiplier-and-units/","h1":"额度单位与流量倍率：上下行计费、重置日与耗尽熔断","co