---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BrandCard from "@/components/BrandCard.astro";
import CommercialDisclosure from "@/components/CommercialDisclosure.astro";
import ComparisonTable from "@/components/ComparisonTable.astro";
import DecisionTree from "@/components/DecisionTree.astro";
import FAQAccordion from "@/components/FAQAccordion.astro";
import servicesData from "@/data/services.json";

const pillar = {"id":"clients","name":"客户端教程","slug":"clients","url":"/clients/","h1":"代理客户端下载与机场教程：设备选择、订阅导入和配置维护","coreQuestion":"下载什么软件，怎么配置，后续如何维护？","theme":"完成使用","targetWords":"7,000–9,500 字","duty":"承接软件下载与正常配置维护。不单独建上网教程。严禁虚构版本与第三方镜像，按项目核验来源。","megaTableCols":["客户端名称","适用系统","官方下载渠道","支持协议","TUN虚拟网卡","规则分流能力","推荐程度","教程直达"],"decisionLevels":4,"topics":[{"id":"selection-and-download","name":"客户端选择与下载","slug":"selection-and-download","url":"/clients/selection-and-download/","h1":"客户端选择与下载：Windows/macOS/Linux/Android/iOS官方正版来源","desc":"盘点Clash Verge Rev、v2rayN、FlClash、Shadowrocket等软件真实发布渠道与避坑。","clusters":[{"id":"desktop-clients","name":"桌面系统客户端","slug":"desktop-clients","url":"/clients/selection-and-download/desktop-clients/","h1":"桌面系统客户端：Clash Verge Rev、v2rayN与macOS/Linux适配指南","coreQuestion":"电脑上该装哪个客户端？如何避开带病毒或加料的第三方二次打包版本？","articles":[{"id":"art-cli-001","title":"Clash Verge Rev Windows 使用"},{"id":"art-cli-002","title":"v2rayN 使用说明"},{"id":"art-cli-003","title":"Windows 客户端下载来源"},{"id":"art-cli-004","title":"Clash Verge Rev macOS 使用"},{"id":"art-cli-005","title":"Linux 客户端说明"},{"id":"art-cli-006","title":"桌面系统客户端完整指南"}]},{"id":"mobile-clients","name":"手机与平板客户端","slug":"mobile-clients","url":"/clients/selection-and-download/mobile-clients/","h1":"手机与平板客户端：Android主流工具、iPhone小火箭与跨移动平台选择","coreQuestion":"安卓和苹果手机上各推荐什么客户端？iOS小火箭如何安全下载？","articles":[{"id":"art-cli-007","title":"Android 客户端有哪些"},{"id":"art-cli-008","title":"FlClash Android 使用"},{"id":"art-cli-009","title":"v2rayNG 使用说明"},{"id":"art-cli-010","title":"iPhone 客户端有哪些"},{"id":"art-cli-011","title":"Shadowrocket 使用说明"},{"id":"art-cli-012","title":"手机与平板客户端完整指南"}]}]},{"id":"import-and-rules","name":"首次导入与规则配置","slug":"import-and-rules","url":"/clients/import-and-rules/","h1":"首次导入与规则配置：订阅链接格式、分流模式、DNS与TUN接管","desc":"从URL一键导入订阅，详解规则、全局与直连模式差异，配置系统接管与抗污染DNS。","clusters":[{"id":"subscription-and-connection","name":"订阅与首次连接","slug":"subscription-and-connection","url":"/clients/import-and-rules/subscription-and-connection/","h1":"订阅与首次连接：订阅链接结构、YAML配置解析与一键导入","coreQuestion":"拿到订阅链接后怎么放进软件？为什么复制进去提示格式不支持？","articles":[{"id":"art-cli-013","title":"订阅格式说明"},{"id":"art-cli-014","title":"YAML 配置结构"},{"id":"art-cli-015","title":"订阅链接与配置文件关系"},{"id":"art-cli-016","title":"订阅导入方法"},{"id":"art-cli-017","title":"首次连接步骤"},{"id":"art-cli-018","title":"订阅与首次连接完整说明"}]},{"id":"rules-dns-tun","name":"规则DNS与接管设置","slug":"rules-dns-tun","url":"/clients/import-and-rules/rules-dns-tun/","h1":"规则DNS与接管设置：分流规则、TUN全局模式与防DNS泄露","coreQuestion":"规则模式和全局模式有什么区别？国内网站如何保持直连不耗流量？","articles":[{"id":"art-cli-019","title":"规则模式说明"},{"id":"art-cli-020","title":"全局模式说明"},{"id":"art-cli-021","title":"直连模式说明"},{"id":"art-cli-022","title":"DNS 设置说明"},{"id":"art-cli-023","title":"TUN 模式说明"},{"id":"art-cli-024","title":"规则DNS与接管设置完整说明"}]}]},{"id":"maintenance-and-advanced","name":"配置维护与进阶接入","slug":"maintenance-and-advanced","url":"/clients/maintenance-and-advanced/","h1":"配置维护与进阶接入：版本平滑升级、规则备份、终端及Git代理","desc":"规范客户端数据备份迁移，为开发环境、终端命令行及软路由提供进阶接管方案。","clusters":[{"id":"update-backup-migration","name":"更新备份与迁移","slug":"update-backup-migration","url":"/clients/maintenance-and-advanced/update-backup-migration/","h1":"更新备份与迁移：客户端版本升级、自定义分流规则备份与跨设备同步","coreQuestion":"软件升级后自定义规则被冲掉怎么办？换新电脑如何一键迁移配置？","articles":[{"id":"art-cli-025","title":"客户端升级方法"},{"id":"art-cli-026","title":"客户端降级方法"},{"id":"art-cli-027","title":"客户端配置备份"},{"id":"art-cli-028","title":"客户端配置恢复"},{"id":"art-cli-029","title":"客户端配置迁移"},{"id":"art-cli-030","title":"更新备份与迁移完整说明"}]},{"id":"router-and-dev-env","name":"路由与开发环境接入","slug":"router-and-dev-env","url":"/clients/maintenance-and-advanced/router-and-dev-env/","h1":"路由与开发环境接入：OpenWrt接入、终端Bash/Git/Pip代理配置","coreQuestion":"如何在VS Code终端、Git Clone及Python Pip安装时正确走上代理？","articles":[{"id":"art-cli-031","title":"路由器接入说明"},{"id":"art-cli-032","title":"开发环境代理配置"},{"id":"art-cli-033","title":"终端与命令行代理"},{"id":"art-cli-034","title":"包管理器代理配置"},{"id":"art-cli-035","title":"Git 代理配置"},{"id":"art-cli-036","title":"路由与开发环境接入完整说明"}]}]}]};
const megaRows = servicesData.map((b: any, index: number) => {
  const isTop1 = b.id === "yunjiexian" || index === 0;
  const targetUrl = `/go.html?id=${b.id}`;

  return [
    b.name,
    isTop1 ? "★ 首选主力专线" : "高性价比备用",
    b.minPayment ? `${b.minPayment} 元/月` : "待核验",
    b.entryPlan || "轻量入门版",
    b.lineType,
    b.protocols,
    b.highlights ? b.highlights[0] : "高速接入",
    b.limitations && b.limitations.length > 0 ? b.limitations[0] : "遵守服务协议",
    {
      text: isTop1 ? "★ 主推入口" : "官网通道",
      url: targetUrl,
      isPrimary: isTop1
    }
  ];
});
const pFaqs = [{"q":"客户端教程栏目的核心定位与评测依据是什么？","a":"本栏目严格遵从「承接软件下载与正常配置维护。不单独建上网教程。严禁虚构版本与第三方镜像，按项目核验来源。」。所有推荐均基于真实采集测试证据与公开服务条款，绝不因商业合作调整客观排序。"},{"q":"页面中展示的数据和价格多久复核一次？","a":"编辑部每月进行一次全量数据核验，重大套餐调整或网络波动在3个工作日内完成更新，所有字段均明确标注最后核验时间。"},{"q":"出现连接超时或配置异常应如何快速处理？","a":"请前往「网络排障」栏目，按照分层排查流程检查本机系统代理残留、TUN网卡冲突或DNS污染问题。"},{"q":"本站推荐是否收取品牌方上榜赞助费？","a":"绝不收取任何上榜赞助费。凡含推广返佣链接的卡片均醒目标注，返佣仅作为服务器与测试带宽支出，不影响用户支付价格与评测中立性。"},{"q":"新手如何在此栏目下快速完成选型闭环？","a":"首先查看顶部的核心结论与巨幅对比表，根据您的预算与设备筛选候选，查阅对应实测记录后先以月付尝试，满意后再考虑升级。"}];
const decisionTreeText = `[ 客户端教程 场景决策模型 ]
  │
  ├── 追求极致稳定性与晚高峰生产力 ───────> 首选：云界线 (IEPL专线 + VLESS)
  │     ├── 需要高稳定专线 + 低预算门槛 ───> 首选：云界线 (折算约5.6元/月起)
  │     └── 多人多设备高并发办公 ─────────> 神行加速 / 闪电鼠
  │
  ├── 严格控制预算 / 轻度查资料 / 备用 ───> 方案：大佬云 / 环球梯 / 榴莲云
  │     └── 月均支出仅 5–8 元区间 ────────> 年付折算或轻度小流量
  │
  └── 遇到网络连接中断或配置疑问 ─────────> 直达：网络排障 (/troubleshooting/)`;
---

<BaseLayout
  title="客户端教程：从使用需求到具体品牌的选购指南 - 机场wiki指南"
  description="代理客户端下载与机场教程：设备选择、订阅导入和配置维护。全面涵盖核心候选对比、使用限制、实测证据、巨幅对比表、ASCII决策树与下辖36篇深度指南。"
  canonicalUrl="https://jichangwiki.cc/clients/"
  breadcrumbs={[
    { name: "首页", url: "/" },
    { name: "客户端教程", url: "/clients/" }
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header Hero -->
    <div class="border-b border-slate-200 pb-8 mb-8">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-800 mb-3">
        <span>一级栏目 Pillar Hub · 万字级权威指南</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">
        代理客户端下载与机场教程：设备选择、订阅导入和配置维护
      </h1>
      <p class="text-lg text-slate-600 leading-relaxed max-w-4xl">
        <strong>核心解答：</strong>下载什么软件，怎么配置，后续如何维护？ 本栏目严格遵循「承接软件下载与正常配置维护。不单独建上网教程。严禁虚构版本与第三方镜像，按项目核验来源。」，拒绝夸大其词，用翔实数据支撑明智决策。
      </p>
    </div>

    <!-- Commercial Transparency Banner -->
    <CommercialDisclosure />

    <!-- 1. Answer-First Section -->
    <section class="my-10 bg-blue-50/50 rounded-2xl p-6 sm:p-8 border border-blue-100">
      <h2 class="text-xl font-bold text-blue-950 mb-3">答案优先：当前场景核心选型结论</h2>
      <p class="text-base text-slate-700 leading-relaxed mb-4">
        对于绝大多数追求稳定性的日常与办公用户，首选应为具备成熟运营历史、全专线架构且支持现代化 VLESS 协议的服务商（如本站主推的<strong>云界线</strong>）。低预算与备用场景可选用 5–8 元月付的轻量方案。选购的核心原则是：<strong>先明确真实月流量需求与关键工具（如ChatGPT/流媒体），首选月付验证，晚高峰实测达标后再行决定是否续约</strong>。
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm">
        <div class="bg-white p-3.5 rounded-xl border border-blue-200">
          <strong class="text-emerald-700 block mb-1">✓ 适合人群：</strong>
          需要跨境学术科研、外贸出海沟通、AI生产力辅助及海外4K流媒体播放的合规用户。
        </div>
        <div class="bg-white p-3.5 rounded-xl border border-blue-200">
          <strong class="text-amber-700 block mb-1">✗ 不适合人群：</strong>
          抱有“几块钱永久不限速无限用”不切实际幻想、或试图利用网络规避审查与非法操作者。
        </div>
      </div>
    </section>

    <!-- 2. ASCII Decision Tree -->
    <section class="my-10">
      <h2 class="text-2xl font-bold text-slate-900 mb-2">快速选择决策树</h2>
      <p class="text-sm text-slate-500 mb-4">通过三层逻辑分支直接对齐您的预算与任务诉求：</p>
      <DecisionTree treeText={decisionTreeText} />
    </section>

    <!-- 3. Mega Comparison Table -->
    <section class="my-10">
      <h2 class="text-2xl font-bold text-slate-900 mb-2">巨幅综合横向对比大盘</h2>
      <p class="text-sm text-slate-500 mb-4">6 家核心品牌横向对比大盘（支持横向滑动）：</p>
      <ComparisonTable
        headers={pillar.megaTableCols}
        rows={megaRows}
        caption="客户端教程 核心候选横向对比表"
      />
    </section>

            <!-- 4. Featured Brand Showcase -->
    <section class="my-10">
      <h2 class="text-2xl font-bold text-slate-900 mb-4">精选代表性服务商深度剖析</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {servicesData.map((b: any) => (
          <BrandCard
            brand={b}
            featuredReason={
              b.id === "yunjiexian" ? "2024年稳定运营，全IEPL专线，低预算首选主力方案" :
              b.id === "dalaoyun" ? "超低预算IEPL专线，高性价比备用首选" :
              b.id === "huanqiuti" ? "经济型轻度专线服务，高性价比备用方案" :
              b.id === "liulianyun" ? "超经济专线中继，轻量备用高性价比之选" :
              b.id === "shandianshu" ? "轻量级低资费专线服务，5.6元/月极致入门备用" :
              b.id === "shenxing" ? "平价大容量IEPL专线，120GB月配额高性价比备用" :
              (b.isPrimaryRecommendation ? "综合性能标杆，全IEPL专线保障晚高峰低丢包" : "性价比专线接入")
            }
          />
        ))}
      </div>
    </section>

    <!-- 5. Under-Pillar Topics & Articles Structure (Honeycomb Links) -->
    <section class="my-12 bg-slate-50 rounded-2xl p-6 sm:p-8 border border-slate-200">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-2xl font-bold text-slate-900">下辖 3 个二级专题与 36 篇深度文章</h2>
          <p class="text-sm text-slate-500 mt-1">蜂巢式内链立体覆盖，可根据具体痛点直达细分指导：</p>
        </div>
        <a href="/sitemap/" class="text-xs font-semibold text-blue-600 hover:underline">
          查阅全站地图 →
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {pillar.topics.map((t: any, tIdx: number) => (
          <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-sm flex flex-col justify-between">
            <div>
              <div class="text-[11px] font-mono font-bold text-blue-600 mb-1">
                专题 0{tIdx + 1}
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">
                <a href={t.url} class="text-slate-900 hover:text-blue-600 transition-colors no-underline">
                  {t.name}
                </a>
              </h3>
              <p class="text-xs text-slate-500 mb-4 leading-relaxed">
                {t.desc}
              </p>

              <!-- Clusters & Articles List -->
              <div class="space-y-3">
                {t.clusters.map((c: any) => (
                  <div class="border-t border-slate-100 pt-2.5">
                    <div class="text-xs font-bold text-slate-800 mb-1.5 flex items-center justify-between">
                      <a href={c.url} class="hover:text-blue-600 transition-colors no-underline">
                        {c.name}
                      </a>
                      <span class="text-[10px] text-slate-400 font-mono">6篇</span>
                    </div>
                    <ul class="space-y-1 text-xs text-slate-600">
                      {c.articles.slice(0, 3).map((art: any) => (
                        <li class="truncate flex items-start space-x-1">
                          <span class="text-blue-500 shrink-0">·</span>
                          <a href={`/articles/${art.id}/`} class="hover:text-blue-600 truncate" title={art.title}>
                            {art.title}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 text-right">
              <a href={t.url} class="text-xs font-semibold text-blue-600 hover:underline">
                浏览此专题完整 12 篇 →
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 6. Long-form In-depth Guide -->
    <section class="my-12">
      <div class="article-content max-w-none">
        <h2>底层机制剖析与选型关键依据</h2>
        <p>
          在选择网络加速服务时，用户往往容易被标称的“峰值带宽”所误导。实际上，决定日常使用顺畅度的三大核心指标并非单线程下载峰值，而是<strong>端到端RTT延迟抖动、晚高峰丢包率与TCP重传率</strong>。
        </p>
        <h3>专线与普通直连的本质鸿沟</h3>
        <p>
          国际互联网出口受国家级骨干网防火墙检测与国际海缆带宽配额限制。普通公网直连（如普通BGP中转）在平峰期表现尚可，一旦进入晚间20:00至23:00的网络流量高峰，国际出口拥堵将直接导致丢包率陡增。而真正采用 IEPL（国际以太网专线）或 IPLC（国际私有租用线路）的服务商，数据直接走陆缆点对点传输，不经过公共国际出口队列，能从物理层根除晚高峰拥堵。
        </p>
        <h3>协议升级：从传统 Shadowsocks 到现代化 VLESS</h3>
        <p>
          随着网络深度包检测（DPI）技术的迭代演进，传统静态特征加密协议（如早期的 Shadowsocks）容易被识别与阻断。现代化协议如 VLESS 配合 XTLS Reality 或 TLS1.3，将代理流量伪装成正常的顶级公网 HTTPS 流量，同时去掉了繁重的双重加密计算开销，不仅极大降低了客户端与服务端延迟，还显著延长了移动设备电池续航。
        </p>
      </div>
    </section>

    <!-- 7. Pillar FAQ Matrix (15 FAQs) -->
    <section class="my-12">
      <FAQAccordion faqs={pFaqs} title="客户端教程 专属常见问题解答 (FAQ)" />
    </section>
  </div>
</BaseLayout>
