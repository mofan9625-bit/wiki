title":"路由与开发环境接入完整说明"}]}]}]};
const topic = {"id":"import-and-rules","name":"首次导入与规则配置","slug":"import-and-rules","url":"/clients/import-and-rules/","h1":"首次导入与规则配置：订阅链接格式、分流模式、DNS与TUN接管","desc":"从URL一键导入订阅，详解规则、全局与直连模式差异，配置系统接管与抗污染DNS。","clusters":[{"id":"subscription-and-connection","name":"订阅与首次连接","slug":"subscription-and-connection","url":"/clients/import-and-rules/subscription-and-connection/","h1":"订阅与首次连接：订阅链接结构、YAML配置解析与一键导入","coreQuestion":"拿到订阅链接后怎么放进软件？为什么复制进去提示格式不支持？","articles":[{"id":"art-cli-013","title":"订阅格式说明"},{"id":"art-cli-014","title":"YAML 配置结构"},{"id":"art-cli-015","title":"订阅链接与配置文件关系"},{"id":"art-cli-016","title":"订阅导入方法"},{"id":"art-cli-017","title":"首次连接步骤"},{"id":"art-cli-018","title":"订阅与首次连接完整说明"}]},{"id":"rules-dns-tun","name":"规则DNS与接管设置","slug":"rules-dns-tun","url":"/clients/import-and-rules/rules-dns-tun/","h1":"规则DNS与接管设置：分流规则、TUN全局模式与防DNS泄露","coreQuestion":"规则模式和全局模式有什么区别？国内网站如何保持直连不耗流量？","articles":[{"id":"art-cli-019","title":"规则模式说明"},{"id":"art-cli-020","title":"全局模式说明"},{"id":"art-cli-021","title":"直连模式说明"},{"id":"art-cli-022","title":"DNS 设置说明"},{"id":"art-cli-023","title":"TUN 模式说明"},{"id":"art-cli-024","title":"规则DNS与接管设置完整说明"}]}]};
