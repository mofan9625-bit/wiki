---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="全站极速静态搜索 - 机场wiki指南"
  description="基于 Pagefind 的全站静态极速搜索，即时检索 553 个规划节点、6 家核心品牌档案及技术百科。"
  breadcrumbs={[
    { name: "首页", url: "/" },
    { name: "搜索", url: "/search/" }
  ]}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-8">
      <h1 class="text-3xl font-extrabold text-slate-900 mb-2">全站搜索</h1>
      <p class="text-sm text-slate-500">
        输入品牌名称（如云界线）、客户端软件（如Clash）、协议或排障问题即时检索：
      </p>
    </div>

    <!-- Pagefind UI Container -->
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <div id="search" class="min-h-[400px]"></div>

    <script is:inline src="/pagefind/pagefind-ui.js"></script>
    <script is:inline>
      window.addEventListener('DOMContentLoaded', () => {
        if (typeof PagefindUI !== 'undefined') {
          new PagefindUI({
            element: "#search",
            showSubResults: true,
            showImages: false,
            translations: {
              placeholder: "搜索全站 553 个内容页面与品牌资料...",
              clear_search: "清除",
              load_more: "加载更多结果",
              search_label: "站内检索",
              filters_label: "分类过滤",
              zero_results: "未找到与 [SEARCH_TERM] 相关的内容",
              many_results: "找到 [COUNT] 个相关结果",
              one_result: "找到 1 个相关结果"
            }
          });
        }
      });
    </script>
  </div>
</BaseLayout>
