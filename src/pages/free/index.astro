---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BrandCard from "@/components/BrandCard.astro";
import CommercialDisclosure from "@/components/CommercialDisclosure.astro";
import ComparisonTable from "@/components/ComparisonTable.astro";
import DecisionTree from "@/components/DecisionTree.astro";
import FAQAccordion from "@/components/FAQAccordion.astro";
import servicesData from "@/data/services.json";

const pillar = {"id":"free","name":"免费机场","slug":"free","url":"/free/","h1":"免费机场与试用指南：资源条件、领取流程和使用边界","coreQuestion":"什么确实免费，如何领取，有什么限制？","theme":"选择服务","targetWords":"7,000–9,500 字","duty":"必须区分：软件免费、服务免费、赠送流量、限时试用和低价付费。解决领取资格与试用验收，技术故障归网络排障。","megaTableCols":["项目名称","资源性质","领取门槛","免费额度","有效周期","安全性与风险","适用场景","替代建议"],"decisionLevels":4,"topics":[{"id":"resource-and-eligibility","name":"免费资源与领取条件","slug":"resource-and-eligibility","url":"/free/resource-and-eligibility/","h1":"免费资源与领取条件：公益识别、开源项目与领取资格","desc":"梳理非营利公益项目、开源项目及商业免费配额的获取要求与资质门槛。","clusters":[{"id":"public-welfare-recognition","name":"公益资源识别","slug":"public-welfare-recognition","url":"/free/resource-and-eligibility/public-welfare-recognition/","h1":"公益资源识别：非营利项目、维护状态与安全风险边界","coreQuestion":"网络上公开分享的免费节点能长期用吗？其安全与隐私风险在哪？","articles":[{"id":"art-free-001","title":"免费机场资源有哪些类型？公益、开源与商业免费区分"},{"id":"art-free-002","title":"公益免费机场项目是什么？非营利模式的可持续性判断"},{"id":"art-free-003","title":"开源项目提供的免费服务能长期用吗？维护状态核对"},{"id":"art-free-004","title":"公开分享的免费订阅安全吗？来源、隐私与风险边界"},{"id":"art-free-005","title":"免费资源能不能用于日常使用？轻度使用与正常使用的差距"},{"id":"art-free-006","title":"免费资源怎么筛选更稳妥？来源、条件与核验清单"}]},{"id":"quota-and-eligibility","name":"领取资格与免费额度","slug":"quota-and-eligibility","url":"/free/resource-and-eligibility/quota-and-eligibility/","h1":"领取资格与免费额度：注册流程、支付绑定与失败排查","coreQuestion":"免费额度领取过程中遇到报错怎么办？是否需要预授权或绑定支付？","articles":[{"id":"art-free-007","title":"免费机场资源怎么领取？常见注册流程与条件说明"},{"id":"art-free-008","title":"免费资源领取是否需要绑定支付方式？"},{"id":"art-free-009","title":"免费资源的流量与时长额度说明"},{"id":"art-free-010","title":"免费资源领取失败的常见原因与处理"},{"id":"art-free-011","title":"免费资源领取前的准备工作：账号、支付与设备清单"},{"id":"art-free-012","title":"免费资源的领取频率与账号条件"}]}]},{"id":"trial-and-verification","name":"机场试用与体验验收","slug":"trial-and-verification","url":"/free/trial-and-verification/","h1":"机场试用与体验验收：试用匹配、验收方法与转付费","desc":"针对商业机场提供的限时或限量试用，指导如何高效测试关键任务并完成购买决策。","clusters":[{"id":"trial-selection","name":"试用方案选择","slug":"trial-selection","url":"/free/trial-and-verification/trial-selection/","h1":"试用方案选择：时长配额、扣费风险与功能开放范围","coreQuestion":"如何选择具有真实测试价值的试用方案？如何防范隐形续费？","articles":[{"id":"art-free-013","title":"机场免费试用怎么选？时长、流量与任务匹配"},{"id":"art-free-014","title":"试用是否需要绑定支付方式？预授权、扣费与取消说明"},{"id":"art-free-015","title":"试用账号的资格限制：新用户、首购与账号条件"},{"id":"art-free-016","title":"试用期时长与流量说明：不同服务的差异"},{"id":"art-free-017","title":"试用期间的服务限制与功能开放范围"},{"id":"art-free-018","title":"试用方案选择完整清单"}]},{"id":"trial-acceptance","name":"试用结果与购买验收","slug":"trial-acceptance","url":"/free/trial-and-verification/trial-acceptance/","h1":"试用结果与购买验收：测试指标、波动记录与付款转换","coreQuestion":"试用期间该测哪些核心指标？何时能确定可以正式付款？","articles":[{"id":"art-free-019","title":"试用期应该测试哪些项目？连接、速度、AI 与视频"},{"id":"art-free-020","title":"试用期的连接验证方法：从订阅导入到正常使用"},{"id":"art-free-021","title":"试用期如何观察服务波动：连续记录与对照方法"},{"id":"art-free-022","title":"试用结束前的决策框架：续用、换用或退出"},{"id":"art-free-023","title":"试用转付费的注意事项：套餐切换与费用核对"},{"id":"art-free-024","title":"试用满意后如何正式购买：流程与凭证留存"}]}]},{"id":"exit-and-alternatives","name":"免费服务退出与替代","slug":"exit-and-alternatives","url":"/free/exit-and-alternatives/","h1":"免费服务退出与替代：失效判断、平价替代与凭证清理","desc":"指导免费节点失效时的替换方案，以及注销账号、清除残留代理规则的安全操作。","clusters":[{"id":"failure-and-alternatives","name":"失效判断与替代路径","slug":"failure-and-alternatives","url":"/free/exit-and-alternatives/failure-and-alternatives/","h1":"失效判断与替代路径：节点状态、平价付费与风险规避","coreQuestion":"免费服务完全失效时，如何以最低成本过渡到低价稳定的替代方案？","articles":[{"id":"art-free-025","title":"免费资源失效怎么判断？状态核对与更新记录"},{"id":"art-free-026","title":"免费资源失效后的替代方案：付费、低价与自建"},{"id":"art-free-027","title":"免费资源与低价付费的差别：成本、服务与责任范围"},{"id":"art-free-028","title":"什么情况下免费资源完全不可用？风险场景与规避"},{"id":"art-free-029","title":"从免费过渡到付费的判断节点"},{"id":"art-free-030","title":"免费资源的退出策略与替代路径完整说明"}]},{"id":"privacy-and-cleanup","name":"隐私检查与配置清理","slug":"privacy-and-cleanup","url":"/free/exit-and-alternatives/privacy-and-cleanup/","h1":"隐私检查与配置清理：数据可见范围、凭据注销与配置归零","coreQuestion":"弃用免费节点后，如何确保客户端配置清理干净、无数据泄露？","articles":[{"id":"art-free-031","title":"免费资源的隐私条款应该怎么读？"},{"id":"art-free-032","title":"免费资源使用中的数据可见范围说明"},{"id":"art-free-033","title":"免费资源退出前的数据清理流程"},{"id":"art-free-034","title":"免费资源账号注销与凭据处理"},{"id":"art-free-035","title":"免费资源使用的安全边界"},{"id":"art-free-036","title":"免费资源隐私检查与清理清单"}]}]}]};
const megaRows = servicesData.map((b: any, index: number) => {
  const isTop1 = b.id === "yunjiexian" || index === 0;
  const targetUrl = `/go.html?id=${b.id}`;

  return [
    b.name,
    isTop1 ? "★ 首选主力专线" : "高性价比备用",
    b.minPayment ? `${b.minPayment} 元/月` : "待核验",
    b.entryPlan || "轻量入门版",
    b.lineType,
    b.protocols,
    b.highlights ? b.highlights[0] : "高速接入",
    b.limitations && b.limitations.length > 0 ? b.limitations[0] : "遵守服务协议",
    {
      text: isTop1 ? "★ 主推入口" : "官网通道",
      url: targetUrl,
      isPrimary: isTop1
    }
  ];
});
const pFaqs = [{"q":"免费机场栏目的核心定位与评测依据是什么？","a":"本栏目严格遵从「必须区分：软件免费、服务免费、赠送流量、限时试用和低价付费。解决领取资格与试用验收，技术故障归网络排障。」。所有推荐均基于真实采集测试证据与公开服务条款，绝不因商业合作调整客观排序。"},{"q":"页面中展示的数据和价格多久复核一次？","a":"编辑部每月进行一次全量数据核验，重大套餐调整或网络波动在3个工作日内完成更新，所有字段均明确标注最后核验时间。"},{"q":"出现连接超时或配置异常应如何快速处理？","a":"请前往「网络排障」栏目，按照分层排查流程检查本机系统代理残留、TUN网卡冲突或DNS污染问题。"},{"q":"本站推荐是否收取品牌方上榜赞助费？","a":"绝不收取任何上榜赞助费。凡含推广返佣链接的卡片均醒目标注，返佣仅作为服务器与测试带宽支出，不影响用户支付价格与评测中立性。"},{"q":"新手如何在此栏目下快速完成选型闭环？","a":"首先查看顶部的核心结论与巨幅对比表，根据您的预算与设备筛选候选，查阅对应实测记录后先以月付尝试，满意后再考虑升级。"}];
const decisionTreeText = `[ 免费机场 场景决策模型 ]
  │
  ├── 追求极致稳定性与晚高峰生产力 ───────> 首选：云界线 (IEPL专线 + VLESS)
  │     ├── 需要高稳定专线 + 低预算门槛 ───> 首选：云界线 (折算约5.6元/月起)
  │     └── 多人多设备高并发办公 ─────────> 神行加速 / 闪电鼠
  │
  ├── 严格控制预算 / 轻度查资料 / 备用 ───> 方案：大佬云 / 环球梯 / 榴莲云
  │     └── 月均支出仅 5–8 元区间 ────────> 年付折算或轻度小流量
  │
  └── 遇到网络连接中断或配置疑问 ─────────> 直达：网络排障 (/troubleshooting/)`;
---

<BaseLayout
  title="免费机场：从使用需求到具体品牌的选购指南 - 机场wiki指南"
  description="免费机场与试用指南：资源条件、领取流程和使用边界。全面涵盖核心候选对比、使用限制、实测证据、巨幅对比表、ASCII决策树与下辖36篇深度指南。"
  canonicalUrl="https://jichangwiki.cc/free/"
  breadcrumbs={[
    { name: "首页", url: "/" },
    { name: "免费机场", url: "/free/" }
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header Hero -->
    <div class="border-b border-slate-200 pb-8 mb-8">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-800 mb-3">
        <span>一级栏目 Pillar Hub · 万字级权威指南</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">
        免费机场与试用指南：资源条件、领取流程和使用边界
      </h1>
      <p class="text-lg text-slate-600 leading-relaxed max-w-4xl">
        <strong>核心解答：</strong>什么确实免费，如何领取，有什么限制？ 本栏目严格遵循「必须区分：软件免费、服务免费、赠送流量、限时试用和低价付费。解决领取资格与试用验收，技术故障归网络排障。」，拒绝夸大其词，用翔实数据支撑明智决策。
      </p>
    </div>

    <!-- Commercial Transparency Banner -->
    <CommercialDisclosure />

    <!-- 1. Answer-First Section -->
    <section class="my-10 bg-blue-50/50 rounded-2xl p-6 sm:p-8 border border-blue-100">
      <h2 class="text-xl font-bold text-blue-950 mb-3">答案优先：当前场景核心选型结论</h2>
      <p class="text-base text-slate-700 leading-relaxed mb-4">
        对于绝大多数追求稳定性的日常与办公用户，首选应为具备成熟运营历史、全专线架构且支持现代化 VLESS 协议的服务商（如本站主推的<strong>云界线</strong>）。低预算与备用场景可选用 5–8 元月付的轻量方案。选购的核心原则是：<strong>先明确真实月流量需求与关键工具（如ChatGPT/流媒体），首选月付验证，晚高峰实测达标后再行决定是否续约</strong>。
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm">
        <div class="bg-white p-3.5 rounded-xl border border-blue-200">
          <strong class="text-emerald-700 block mb-1">✓ 适合人群：</strong>
          需要跨境学术科研、外贸出海沟通、AI生产力辅助及海外4K流媒体播放的合规用户。
        </div>
        <div class="bg-white p-3.5 rounded-xl border border-blue-200">
          <strong class="text-amber-700 block mb-1">✗ 不适合人群：</strong>
          抱有“几块钱永久不限速无限用”不切实际幻想、或试图利用网络规避审查与非法操作者。
        </div>
      </div>
    </section>

    <!-- 2. ASCII Decision Tree -->
    <section class="my-10">
      <h2 class="text-2xl font-bold text-slate-900 mb-2">快速选择决策树</h2>
      <p class="text-sm text-slate-500 mb-4">通过三层逻辑分支直接对齐您的预算与任务诉求：</p>
      <DecisionTree treeText={decisionTreeText} />
    </section>

    <!-- 3. Mega Comparison Table -->
    <section class="my-10">
      <h2 class="text-2xl font-bold text-slate-900 mb-2">巨幅综合横向对比大盘</h2>
      <p class="text-sm text-slate-500 mb-4">6 家核心品牌横向对比大盘（支持横向滑动）：</p>
      <ComparisonTable
        headers={pillar.megaTableCols}
        rows={megaRows}
        caption="免费机场 核心候选横向对比表"
      />
    </section>

            <!-- 4. Featured Brand Showcase -->
    <section class="my-10">
      <h2 class="text-2xl font-bold text-slate-900 mb-4">精选代表性服务商深度剖析</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {servicesData.map((b: any) => (
          <BrandCard
            brand={b}
            featuredReason={
              b.id === "yunjiexian" ? "2024年稳定运营，全IEPL专线，低预算首选主力方案" :
              b.id === "dalaoyun" ? "超低预算IEPL专线，高性价比备用首选" :
              b.id === "huanqiuti" ? "经济型轻度专线服务，高性价比备用方案" :
              b.id === "liulianyun" ? "超经济专线中继，轻量备用高性价比之选" :
              b.id === "shandianshu" ? "轻量级低资费专线服务，5.6元/月极致入门备用" :
              b.id === "shenxing" ? "平价大容量IEPL专线，120GB月配额高性价比备用" :
              (b.isPrimaryRecommendation ? "综合性能标杆，全IEPL专线保障晚高峰低丢包" : "性价比专线接入")
            }
          />
        ))}
      </div>
    </section>

    <!-- 5. Under-Pillar Topics & Articles Structure (Honeycomb Links) -->
    <section class="my-12 bg-slate-50 rounded-2xl p-6 sm:p-8 border border-slate-200">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-2xl font-bold text-slate-900">下辖 3 个二级专题与 36 篇深度文章</h2>
          <p class="text-sm text-slate-500 mt-1">蜂巢式内链立体覆盖，可根据具体痛点直达细分指导：</p>
        </div>
        <a href="/sitemap/" class="text-xs font-semibold text-blue-600 hover:underline">
          查阅全站地图 →
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {pillar.topics.map((t: any, tIdx: number) => (
          <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-sm flex flex-col justify-between">
            <div>
              <div class="text-[11px] font-mono font-bold text-blue-600 mb-1">
                专题 0{tIdx + 1}
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">
                <a href={t.url} class="text-slate-900 hover:text-blue-600 transition-colors no-underline">
                  {t.name}
                </a>
              </h3>
              <p class="text-xs text-slate-500 mb-4 leading-relaxed">
                {t.desc}
              </p>

              <!-- Clusters & Articles List -->
              <div class="space-y-3">
                {t.clusters.map((c: any) => (
                  <div class="border-t border-slate-100 pt-2.5">
                    <div class="text-xs font-bold text-slate-800 mb-1.5 flex items-center justify-between">
                      <a href={c.url} class="hover:text-blue-600 transition-colors no-underline">
                        {c.name}
                      </a>
                      <span class="text-[10px] text-slate-400 font-mono">6篇</span>
                    </div>
                    <ul class="space-y-1 text-xs text-slate-600">
                      {c.articles.slice(0, 3).map((art: any) => (
                        <li class="truncate flex items-start space-x-1">
                          <span class="text-blue-500 shrink-0">·</span>
                          <a href={`/articles/${art.id}/`} class="hover:text-blue-600 truncate" title={art.title}>
                            {art.title}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 text-right">
              <a href={t.url} class="text-xs font-semibold text-blue-600 hover:underline">
                浏览此专题完整 12 篇 →
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 6. Long-form In-depth Guide -->
    <section class="my-12">
      <div class="article-content max-w-none">
        <h2>底层机制剖析与选型关键依据</h2>
        <p>
          在选择网络加速服务时，用户往往容易被标称的“峰值带宽”所误导。实际上，决定日常使用顺畅度的三大核心指标并非单线程下载峰值，而是<strong>端到端RTT延迟抖动、晚高峰丢包率与TCP重传率</strong>。
        </p>
        <h3>专线与普通直连的本质鸿沟</h3>
        <p>
          国际互联网出口受国家级骨干网防火墙检测与国际海缆带宽配额限制。普通公网直连（如普通BGP中转）在平峰期表现尚可，一旦进入晚间20:00至23:00的网络流量高峰，国际出口拥堵将直接导致丢包率陡增。而真正采用 IEPL（国际以太网专线）或 IPLC（国际私有租用线路）的服务商，数据直接走陆缆点对点传输，不经过公共国际出口队列，能从物理层根除晚高峰拥堵。
        </p>
        <h3>协议升级：从传统 Shadowsocks 到现代化 VLESS</h3>
        <p>
          随着网络深度包检测（DPI）技术的迭代演进，传统静态特征加密协议（如早期的 Shadowsocks）容易被识别与阻断。现代化协议如 VLESS 配合 XTLS Reality 或 TLS1.3，将代理流量伪装成正常的顶级公网 HTTPS 流量，同时去掉了繁重的双重加密计算开销，不仅极大降低了客户端与服务端延迟，还显著延长了移动设备电池续航。
        </p>
