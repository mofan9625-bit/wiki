const pillar = {"id":"recommend","name":"机场推荐","slug":"recommend","url":"/recommend/","h1":"机场推荐：从使用需求到具体品牌的选购指南","coreQuestion":"有哪些具体机场值得考虑，为什么适合我？","theme":"选择服务","targetWords":"7,000–9,500 字","duty":"负责稳定性选型，评测栏目负责测试依据。每家机场展开：定位、适合与不适合、套餐、使用方式、证据、限制与建议。","megaTableCols":["品牌","定位与首选度","最低月付","入门套餐","线路类型","主流协议","适合人群","核心限制","直达通道"],"decisionLevels":4,"topics":[{"id":"first-purchase","name":"首次选购与服务切换","slug":"first-purchase","url":"/recommend/first-purchase/","h1":"首次选购与服务切换指南：从新手决策到主备搭配","desc":"解决新手选购的设备与软件认知，以及老用户换机场与主备搭配的迁移成本核算。","clusters":[{"id":"beginner-decision","name":"新手选购决策","slug":"beginner-decision","url":"/recommend/first-purchase/beginner-decision/","h1":"新手选购决策：设备匹配、套餐筛选与试用落地","coreQuestion":"第一次买机场怎么选？如何从设备、用途到套餐建立完整决策链条？","articles":[{"id":"art-rec-001","title":"第一次买机场怎么选？从设备、用途到套餐的完整决策流程"},{"id":"art-rec-002","title":"机场推荐榜单怎么看？识别广告排序、测试依据与适用人群"},{"id":"art-rec-003","title":"只有手机的新手适合哪类机场？自有客户端与通用客户端方案比较"},{"id":"art-rec-004","title":"已有代理客户端还需要买什么？机场订阅与软件授权的区别"},{"id":"art-rec-005","title":"机场购买前应该问客服哪些问题？用需求清单筛掉不合适的服务"},{"id":"art-rec-006","title":"机场试用满意后怎么买正式套餐？从体验结果到付款周期的选择"}]},{"id":"switch-and-combo","name":"换机场与组合使用","slug":"switch-and-combo","url":"/recommend/first-purchase/switch-and-combo/","h1":"换机场与组合使用：续费决策、迁移清单与主备方案","coreQuestion":"机场到期后换一家还是续费？主备双机场如何搭建才能实现故障真正独立？","articles":[{"id":"art-rec-007","title":"机场到期后换一家还是续费？迁移成本、使用记录与费用一起比较"},{"id":"art-rec-008","title":"更换机场前要确认什么？设备、协议兼容与订阅迁移检查清单"},{"id":"art-rec-009","title":"主用加备用机场怎么搭配？故障独立性、成本与管理难度比较"},{"id":"art-rec-010","title":"什么情况下两个机场同时使用更合适？多设备与工作场景分析"},{"id":"art-rec-011","title":"从便宜机场升级到中端服务怎么选？预算与体验变化评估"},{"id":"art-rec-012","title":"一个账号多台设备使用时应该注意哪些限制？并发连接与规则检查"}]}]},{"id":"conditions-and-devices","name":"使用条件与设备需求","slug":"conditions-and-devices","url":"/recommend/conditions-and-devices/","h1":"使用条件与设备需求：移动漫游、多端协作与合规核对","desc":"覆盖差旅出差、移动热点切换以及多设备家庭、公司与学校网络下的限制与选型。","clusters":[{"id":"mobile-and-travel","name":"移动网络与外出使用","slug":"mobile-and-travel","url":"/reco