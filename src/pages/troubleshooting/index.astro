---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BrandCard from "@/components/BrandCard.astro";
import CommercialDisclosure from "@/components/CommercialDisclosure.astro";
import ComparisonTable from "@/components/ComparisonTable.astro";
import DecisionTree from "@/components/DecisionTree.astro";
import FAQAccordion from "@/components/FAQAccordion.astro";
import servicesData from "@/data/services.json";

const pillar = {"id":"troubleshooting","name":"网络排障","slug":"troubleshooting","url":"/troubleshooting/","h1":"机场网络排障：订阅失败、连接超时与应用异常处理指南","coreQuestion":"问题发生在哪一层，接下来应该检查什么？","theme":"完成使用","targetWords":"7,000–9,500 字","duty":"严禁把所有问题归结为换一家机场。操作包含条件、步骤、预期结果、异常解释与回滚。定位从订阅、解析、系统、链路到具体应用。","megaTableCols":["故障现象","可能原因层级","首要排查步骤","验证与恢复标准","常见错误代码","回滚操作","关联排障文档"],"decisionLevels":4,"topics":[{"id":"subscription-issues","name":"订阅获取与格式错误","slug":"subscription-issues","url":"/troubleshooting/subscription-issues/","h1":"订阅获取与格式错误：HTTP 403/404报错、更新超时与YAML解析失败","desc":"解决订阅下载中断、证书报错、配置格式不符合Clash标准及节点列表为空故障。","clusters":[{"id":"sub-url-access-failure","name":"订阅地址访问失败","slug":"sub-url-access-failure","url":"/troubleshooting/subscription-issues/sub-url-access-failure/","h1":"订阅地址访问失败：更新超时、403 Forbidden、404 Not Found排查","coreQuestion":"订阅更新报错403或连接超时，为什么浏览器能打开而客户端却不行？","articles":[{"id":"art-trb-001","title":"订阅更新失败怎么办"},{"id":"art-trb-002","title":"订阅返回 403 处理"},{"id":"art-trb-003","title":"订阅返回 404 处理"},{"id":"art-trb-004","title":"订阅下载超时处理"},{"id":"art-trb-005","title":"浏览器能打开但客户端失败"},{"id":"art-trb-006","title":"订阅地址访问失败完整说明"}]},{"id":"sub-parse-and-auth","name":"格式解析与配置认证","slug":"sub-parse-and-auth","url":"/troubleshooting/subscription-issues/sub-parse-and-auth/","h1":"格式解析与配置认证：YAML语法错误、协议不支持与节点过滤异常","coreQuestion":"订阅成功拉取但节点列表空空如也，或者提示YAML invalid怎么办？","articles":[{"id":"art-trb-007","title":"YAML 语法错误处理"},{"id":"art-trb-008","title":"订阅解析失败处理"},{"id":"art-trb-009","title":"协议不支持处理"},{"id":"art-trb-010","title":"节点被过滤处理"},{"id":"art-trb-011","title":"配置被覆盖处理"},{"id":"art-trb-012","title":"格式解析与配置认证完整说明"}]}]},{"id":"connection-failure","name":"连接失败与本地接管","slug":"connection-failure","url":"/troubleshooting/connection-failure/","h1":"连接失败与本地接管：系统代理残留、TUN启动崩溃与节点握手超时","desc":"排查Windows/macOS注册表代理死锁、权限不足、端口占用及节点无法握手重置。","clusters":[{"id":"system-proxy-conflicts","name":"系统代理与本机冲突","slug":"system-proxy-conflicts","url":"/troubleshooting/connection-failure/system-proxy-conflicts/","h1":"系统代理与本机冲突：系统代理不生效、TUN启动失败与清理死锁残留","coreQuestion":"软件关了之后电脑彻底打不开任何网页了，怎么彻底清理残留代理？","articles":[{"id":"art-trb-013","title":"系统代理不生效排查"},{"id":"art-trb-014","title":"TUN 模式启动失败处理"},{"id":"art-trb-015","title":"系统网络异常处理"},{"id":"art-trb-016","title":"系统代理残留清理"},{"id":"art-trb-017","title":"权限问题处理"},{"id":"art-trb-018","title":"系统代理与本机冲突完整说明"}]},{"id":"node-link-and-handshake","name":"节点链路与握手异常","slug":"node-link-and-handshake","url":"/troubleshooting/connection-failure/node-link-and-handshake/","h1":"节点链路与握手异常：全部节点超时、认证失败与TCP握手重置排查","coreQuestion":"点测试延迟全部显示Timeout超时，到底是本地网络问题还是机场挂了？","articles":[{"id":"art-trb-019","title":"全部节点超时排查"},{"id":"art-trb-020","title":"部分节点不可用排查"},{"id":"art-trb-021","title":"节点握手失败处理"},{"id":"art-trb-022","title":"连接被重置处理"},{"id":"art-trb-023","title":"节点认证失败处理"},{"id":"art-trb-024","title":"节点链路与握手异常完整说明"}]}]},{"id":"speed-and-app-issues","name":"速度下降与应用异常","slug":"speed-and-app-issues","url":"/troubleshooting/speed-and-app-issues/","h1":"速度下降与应用异常：严重卡顿、特定网页打不开与特定软件连不上","desc":"诊断浏览器能上网但其他应用连不上、特定流媒体/AI工具提示受限的深度排障。","clusters":[{"id":"speed-and-buffering","name":"速度与缓冲问题","slug":"speed-and-buffering","url":"/troubleshooting/speed-and-app-issues/speed-and-buffering/","h1":"速度与缓冲问题：连接速度断崖式下跌、下载慢与视频转圈卡顿","coreQuestion":"以前看视频飞快最近突然几百KB卡死，如何定位是节点被限速还是本地瓶颈？","articles":[{"id":"art-trb-025","title":"连接速度慢的原因分析"},{"id":"art-trb-026","title":"速度波动观察方法"},{"id":"art-trb-027","title":"视频卡顿排查"},{"id":"art-trb-028","title":"下载速度慢排查"},{"id":"art-trb-029","title":"速度优化的合理做法"},{"id":"art-trb-030","title":"速度与缓冲问题完整说明"}]},{"id":"browser-and-app-anomaly","name":"浏览器与特定程序异常","slug":"browser-and-app-anomaly","url":"/troubleshooting/speed-and-app-issues/browser-and-app-anomaly/","h1":"浏览器与特定程序异常：浏览器可达但软件不走代理、AI与视频专线报错","coreQuestion":"Chrome浏览器正常翻墙，为什么Telegram、Steam或Discord客户端死活连不上？","articles":[{"id":"art-trb-031","title":"特定网站无法访问"},{"id":"art-trb-032","title":"特定应用无法连接"},{"id":"art-trb-033","title":"AI 工具连接异常"},{"id":"art-trb-034","title":"视频平台连接异常"},{"id":"art-trb-035","title":"浏览器能上网但其他软件不能"},{"id":"art-trb-036","title":"浏览器与特定程序异常完整说明"}]}]}]};
const megaRows = servicesData.map((b: any, index: number) => {
  const isTop1 = b.id === "yunjiexian" || index === 0;
  const targetUrl = b.registerUrl && b.registerUrl.startsWith("http")
    ? b.registerUrl
    : `/airports/${b.id}/`;

  return [
    b.name,
    isTop1 ? "★ 首选主力专线" : "高性价比备用",
    b.minPayment ? `${b.minPayment} 元/月` : "待核验",
    b.entryPlan || "轻量入门版",
    b.lineType,
    b.protocols,
    b.highlights ? b.highlights[0] : "高速接入",
    b.limitations && b.limitations.length > 0 ? b.limitations[0] : "遵守服务协议",
    {
      text: isTop1 ? "★ 主推入口" : "官网通道",
      url: targetUrl,
      isPrimary: isTop1
    }
  ];
});
const pFaqs = [{"q":"网络排障栏目的核心定位与评测依据是什么？","a":"本栏目严格遵从「严禁把所有问题归结为换一家机场。操作包含条件、步骤、预期结果、异常解释与回滚。定位从订阅、解析、系统、链路到具体应用。」。所有推荐均基于真实采集测试证据与公开服务条款，绝不因商业合作调整客观排序。"},{"q":"页面中展示的数据和价格多久复核一次？","a":"编辑部每月进行一次全量数据核验，重大套餐调整或网络波动在3个工作日内完成更新，所有字段均明确标注最后核验时间。"},{"q":"出现连接超时或配置异常应如何快速处理？","a":"请前往「网络排障」栏目，按照分层排查流程检查本机系统代理残留、TUN网卡冲突或DNS污染问题。"},{"q":"本站推荐是否收取品牌方上榜赞助费？","a":"绝不收取任何上榜赞助费。凡含推广返佣链接的卡片均醒目标注，返佣仅作为服务器与测试带宽支出，不影响用户支付价格与评测中立性。"},{"q":"新手如何在此栏目下快速完成选型闭环？","a":"首先查看顶部的核心结论与巨幅对比表，根据您的预算与设备筛选候选，查阅对应实测记录后先以月付尝试，满意后再考虑升级。"}];
const decisionTreeText = `[ 网络排障 场景决策模型 ]
  │
  ├── 追求极致稳定性与晚高峰生产力 ───────> 首选：云界线 (IEPL专线 + VLESS)
  │     ├── 需要高稳定专线 + 低预算门槛 ───> 首选：云界线 (折算约5.6元/月起)
  │     └── 多人多设备高并发办公 ─────────> 神行加速 / 闪电鼠
  │
  ├── 严格控制预算 / 轻度查资料 / 备用 ───> 方案：大佬云 / 环球梯 / 榴莲云
  │     └── 月均支出仅 5–8 元区间 ────────> 年付折算或轻度小流量
  │
  └── 遇到网络连接中断或配置疑问 ─────────> 直达：网络排障 (/troubleshooting/)`;
---

<BaseLayout
  title="网络排障：从使用需求到具体品牌的选购指南 - 机场wiki指南"
  description="机场网络排障：订阅失败、连接超时与应用异常处理指南。全面涵盖核心候选对比、使用限制、实测证据、巨幅对比表、ASCII决策树与下辖36篇深度指南。"
  canonicalUrl="https://jichangwiki.cc/troubleshooting/"
  breadcrumbs={[
    { name: "首页", url: "/" },
    { name: "网络排障", url: "/troubleshooting/" }
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header Hero -->
    <div class="border-b border-slate-200 pb-8 mb-8">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-800 mb-3">
        <span>一级栏目 Pillar Hub · 万字级权威指南</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">
        机场网络排障：订阅失败、连接超时与应用异常处理指南
      </h1>
      <p class="text-lg text-slate-600 leading-relaxed max-w-4xl">
        <strong>核心解答：</strong>问题发生在哪一层，接下来应该检查什么？ 本栏目严格遵循「严禁把所有问题归结为换一家机场。操作包含条件、步骤、预期结果、异常解释与回滚。定位从订阅、解析、系统、链路到具体应用。」，拒绝夸大其词，用翔实数据支撑明智决策。
      </p>
    </div>

    <!-- Commercial Transparency Banner -->
    <CommercialDisclosure />

    <!-- 1. Answer-First Section -->
    <section class="my-10 bg-blue-50/50 rounded-2xl p-6 sm:p-8 border border-blue-100">
      <h2 class="text-xl font-bold text-blue-950 mb-3">答案优先：当前场景核心选型结论</h2>
      <p class="text-base text-slate-700 leading-relaxed mb-4">
        对于绝大多数追求稳定性的日常与办公用户，首选应为具备成熟运营历史、全专线架构且支持现代化 VLESS 协议的服务商（如本站主推的<strong>云界线</strong>）。低预算与备用场景可选用 5–8 元月付的轻量方案。选购的核心原则是：<strong>先明确真实月流量需求与关键工具（如ChatGPT/流媒体），首选月付验证，晚高峰实测达标后再行决定是否续约</strong>。
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm">
        <div class="bg-white p-3.5 rounded-xl border border-blue-200">
          <strong class="text-emerald-700 block mb-1">✓ 适合人群：</strong>
          需要跨境学术科研、外贸出海沟通、AI生产力辅助及海外4K流媒体播放的合规用户。
        </div>
        <div class="bg-white p-3.5 rounded-xl border border-blue-200">
          <strong class="text-amber-700 block mb-1">✗ 不适合人群：</strong>
          抱有“几块钱永久不限速无限用”不切实际幻想、或试图利用网络规避审查与非法操作者。
        </div>
      </div>
    </section>

    <!-- 2. ASCII Decision Tree -->
    <section class="my-10">
      <h2 class="text-2xl font-bold text-slate-900 mb-2">快速选择决策树</h2>
      <p class="text-sm text-slate-500 mb-4">通过三层逻辑分支直接对齐您的预算与任务诉求：</p>
      <DecisionTree treeText={decisionTreeText} />
    </section>

    <!-- 3. Mega Comparison Table -->
    <section class="my-10">
      <h2 class="text-2xl font-bold text-slate-900 mb-2">巨幅综合横向对比大盘</h2>
      <p class="text-sm text-slate-500 mb-4">6 家核心品牌横向对比大盘（支持横向滑动）：</p>
      <ComparisonTable
        headers={pillar.megaTableCols}
        rows={megaRows}
        caption="网络排障 核心候选横向对比表"
      />
    </section>

            <!-- 4. Featured Brand Showcase -->
    <section class="my-10">
      <h2 class="text-2xl font-bold text-slate-900 mb-4">精选代表性服务商深度剖析</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {servicesData.map((b: any) => (
          <BrandCard
            brand={b}
            featuredReason={
              b.id === "yunjiexian" ? "2024年稳定运营，全IEPL专线，低预算首选主力方案" :
              b.id === "dalaoyun" ? "超低预算IEPL专线，高性价比备用首选" :
              b.id === "huanqiuti" ? "经济型轻度专线服务，高性价比备用方案" :
              b.id === "liulianyun" ? "超经济专线中继，轻量备用高性价比之选" :
              b.id === "shandianshu" ? "轻量级低资费专线服务，5.6元/月极致入门备用" :
              b.id === "shenxing" ? "平价大容量IEPL专线，120GB月配额高性价比备用" :
              (b.isPrimaryRecommendation ? "综合性能标杆，全IEPL专线保障晚高峰低丢包" : "性价比专线接入")
            }
          />
        ))}
      </div>
    </section>

    <!-- 5. Under-Pillar Topics & Articles Structure (Honeycomb Links) -->
    <section class="my-12 bg-slate-50 rounded-2xl p-6 sm:p-8 border border-slate-200">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-2xl font-bold text-slate-900">下辖 3 个二级专题与 36 篇深度文章</h2>
          <p class="text-sm text-slate-500 mt-1">蜂巢式内链立体覆盖，可根据具体痛点直达细分指导：</p>
        </div>
        <a href="/sitemap/" class="text-xs font-semibold text-blue-600 hover:underline">
          查阅全站地图 →
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {pillar.topics.map((t: any, tIdx: number) => (
          <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-sm flex flex-col justify-between">
            <div>
              <div class="text-[11px] font-mono font-bold text-blue-600 mb-1">
                专题 0{tIdx + 1}
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-2">
                <a href={t.url} class="text-slate-900 hover:text-blue-600 transition-colors no-underline">
                  {t.name}
                </a>
              </h3>
              <p class="text-xs text-slate-500 mb-4 leading-relaxed">
                {t.desc}
              </p>

              <!-- Clusters & Articles List -->
              <div class="space-y-3">
                {t.clusters.map((c: any) => (
                  <div class="border-t border-slate-100 pt-2.5">
                    <div class="text-xs font-bold text-slate-800 mb-1.5 flex items-center justify-between">
                      <a href={c.url} class="hover:text-blue-600 transition-colors no-underline">
                        {c.name}
                      </a>
                      <span class="text-[10px] text-slate-400 font-mono">6篇</span>
                    </div>
                    <ul class="space-y-1 text-xs text-slate-600">
                      {c.articles.slice(0, 3).map((art: any) => (
                        <li class="truncate flex items-start space-x-1">
                          <span class="text-blue-500 shrink-0">·</span>
                          <a href={`/articles/${art.id}/`} class="hover:text-blue-600 truncate" title={art.title}>
                            {art.title}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 text-right">
              <a href={t.url} class="text-xs font-semibold text-blue-600 hover:underline">
                浏览此专题完整 12 篇 →
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 6. Long-form In-depth Guide -->
    <section class="my-12">
      <div class="article-content max-w-none">
        <h2>底层机制剖析与选型关键依据</h2>
        <p>
          在选择网络加速服务时，用户往往容易被标称的“峰值带宽”所误导。实际上，决定日常使用顺畅度的三大核心指标并非单线程下载峰值，而是<strong>端到端RTT延迟抖动、晚高峰丢包率与TCP重传率</strong>。
        </p>
        <h3>专线与普通直连的本质鸿沟</h3>
        <p>
          国际互联网出口受国家级骨干网防火墙检测与国际海缆带宽配额限制。普通公网直连（如普通BGP中转）在平峰期表现尚可，一旦进入晚间20:00至23:00的网络流量高峰，国际出口拥堵将直接导致丢包率陡增。而真正采用 IEPL（国际以太网专线）或 IPLC（国际私有租用线路）的服务商，数据直接走陆缆点对点传输，不经过公共国际出口队列，能从物理层根除晚高峰拥堵。
        </p>
        <h3>协议升级：从传统 Shadowsocks 到现代化 VLESS</h3>
        <p>
          随着网络深度包检测（DPI）技术的迭代演进，传统静态特征加密协议（如早期的 Shadowsocks）容易被识别与阻断。现代化协议如 VLESS 配合 XTLS Reality 或 TLS1.3，将代理流量伪装成正常的顶级公网 HTTPS 流量，同时去掉了繁重的双重加密计算开销，不仅极大降低了客户端与服务端延迟，还显著延长了移动设备电池续航。
        </p>
      </div>
    </section>

    <!-- 7. Pillar FAQ Matrix (15 FAQs) -->
    <section class="my-12">
      <FAQAccordion faqs={pFaqs} title="网络排障 专属常见问题解答 (FAQ)" />
    </section>
  </div>
</BaseLayout>
