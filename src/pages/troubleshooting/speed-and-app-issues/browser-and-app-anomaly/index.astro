const topic = {"id":"speed-and-app-issues","name":"速度下降与应用异常","slug":"speed-and-app-issues","url":"/troubleshooting/speed-and-app-issues/","h1":"速度下降与应用异常：严重卡顿、特定网页打不开与特定软件连不上","desc":"诊断浏览器能上网但其他应用连不上、特定流媒体/AI工具提示受限的深度排障。","clusters":[{"id":"speed-and-buffering","name":"速度与缓冲问题","slug":"speed-and-buffering","url":"/troubleshooting/speed-and-app-issues/speed-and-buffering/","h1":"速度与缓冲问题：连接速度断崖式下跌、下载慢与视频转圈卡顿","coreQuestion":"以前看视频飞快最近突然几百KB卡死，如何定位是节点被限速还是本地瓶颈？","articles":[{"id":"art-trb-025","title":"连接速度慢的原因分析"},{"id":"art-trb-026","title":"速度波动观察方法"},{"id":"art-trb-027","title":"视频卡顿排查"},{"id":"art-trb-028","title":"下载速度慢排查"},{"id":"art-trb-029","title":"速度优化的合理做法"},{"id":"art-trb-030","title":"速度与缓冲问题完整说明"}]},{"id":"browser-and-app-anomaly","name":"浏览器与特定程序异常","slug":"browser-and-app-anomaly","url":"/troubleshooting/speed-and-app-issues/browser-and-app-anomaly/","h1":"浏览器与特定程序异常：浏览器可达但软件不走代理、AI与视频专线报错","coreQuestion":"Chrome浏览器正常翻墙，为什么Telegram、Steam或Discord客户端死活连不上？","articles":[{"id":"art-trb-031","title":"特定网站无法访问"},{"id":"art-trb-032","title":"特定应用无法连接"},{"id":"art-trb-033","title":"AI 工具连接异常"},{"id":"art-trb-034","title":"视频平台连接异常"},{"id":"art-trb-035","title":"浏览器能上网但其他软件不能"},{"id":"art-trb-036","title":"浏览器与特定程序异常完整说明"}]}]};
